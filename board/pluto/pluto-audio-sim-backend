#!/usr/bin/env python3
"""Generate bounded PCM test audio for Pluto firmware audio API validation."""

import math
import os
import signal
import struct
import sys
import time


running = True


def stop(_signum, _frame):
    global running
    running = False


def main():
    fifo = os.environ.get("PLUTO_AUDIO_FIFO", "/var/run/pluto-radio/audio.pcm")
    rate = int(os.environ.get("PLUTO_AUDIO_RATE_HZ", "48000") or "48000")
    tone_hz = int(os.environ.get("PLUTO_AUDIO_TEST_TONE_HZ", "700") or "700")
    amplitude = 5000
    phase = 0.0
    step = 2.0 * math.pi * tone_hz / rate

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    while running:
        try:
            with open(fifo, "wb", buffering=0) as handle:
                while running:
                    frames = bytearray()
                    for _ in range(1024):
                        frames.extend(struct.pack("<h", int(math.sin(phase) * amplitude)))
                        phase += step
                        if phase > 2.0 * math.pi:
                            phase -= 2.0 * math.pi
                    handle.write(frames)
                    time.sleep(1024.0 / rate)
        except BrokenPipeError:
            time.sleep(0.05)
        except FileNotFoundError:
            time.sleep(0.25)

    return 0


if __name__ == "__main__":
    sys.exit(main())
