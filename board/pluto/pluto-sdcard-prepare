#!/bin/sh

destdir=/media
blkid_bin="${BLKID:-/sbin/blkid}"
fsck_vfat_bin="${FSCK_VFAT:-/sbin/fsck.vfat}"
e2fsck_bin="${E2FSCK:-/sbin/e2fsck}"
mke2fs_bin="${MKE2FS:-/usr/sbin/mke2fs}"
resize2fs_bin="${RESIZE2FS:-/usr/sbin/resize2fs}"
partprobe_bin="${PARTPROBE:-/sbin/partprobe}"

log() {
	logger -t pluto-sdcard-prepare "$*"
}

is_sd_part() {
	case "$1" in
		mmcblk[0-9]p[0-9]|mmcblk[0-9]p[0-9][0-9])
			return 0
			;;
		*)
			return 1
			;;
	esac
}

is_sd_boot_part() {
	case "$1" in
		mmcblk[0-9]p1)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

is_sd_data_part() {
	case "$1" in
		mmcblk[0-9]p2)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

sd_parent_disk() {
	echo "$1" | sed 's/p[0-9][0-9]*$//'
}

is_mounted() {
	grep -qs "^/dev/$1 " /proc/mounts
}

mount_opts() {
	case "$1" in
		mmcblk*)
			echo noatime
			;;
		*)
			echo sync
			;;
	esac
}

mount_point() {
	if is_sd_data_part "$1"; then
		echo "${destdir}"
	else
		echo "${destdir}/$1"
	fi
}

mount_is_rw() {
	local dev="$1"
	awk -v dev="/dev/$dev" '$1 == dev {
		split($4, opts, ",")
		for (i in opts) {
			if (opts[i] == "rw")
				found = 1
		}
	} END { exit found ? 0 : 1 }' /proc/mounts
}

mounted_fs_type() {
	local dev="$1"
	awk -v dev="/dev/$dev" '$1 == dev { print $3; exit }' /proc/mounts
}

blkid_fs_type() {
	local dev="$1"

	if [ -x "$blkid_bin" ]; then
		"$blkid_bin" "/dev/$dev" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'
	else
		blkid "/dev/$dev" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'
	fi
}

is_fat_type() {
	case "$1" in
		vfat|msdos|fat)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

is_ext_type() {
	case "$1" in
		ext2|ext3|ext4)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

is_supported_type() {
	is_fat_type "$1" || is_ext_type "$1"
}

fsck_fat() {
	local dev="$1"
	local rc

	if ! is_sd_part "$dev"; then
		return 0
	fi

	if [ ! -x "$fsck_vfat_bin" ] && ! command -v fsck.vfat >/dev/null 2>&1; then
		log "fsck.vfat not available; cannot repair /dev/$dev"
		return 1
	fi

	if [ -x "$fsck_vfat_bin" ]; then
		"$fsck_vfat_bin" -a "/dev/$dev"
	else
		fsck.vfat -a "/dev/$dev"
	fi
	rc=$?

	case "$rc" in
		0|1)
			return 0
			;;
		*)
			log "fsck.vfat failed for /dev/$dev with exit code $rc"
			return "$rc"
			;;
	esac
}

fsck_ext() {
	local dev="$1"
	local rc

	if ! is_sd_part "$dev"; then
		return 0
	fi

	if [ ! -x "$e2fsck_bin" ] && ! command -v e2fsck >/dev/null 2>&1; then
		log "e2fsck not available; cannot repair /dev/$dev"
		return 1
	fi

	if [ -x "$e2fsck_bin" ]; then
		"$e2fsck_bin" -p "/dev/$dev"
	else
		e2fsck -p "/dev/$dev"
	fi
	rc=$?

	case "$rc" in
		0|1|2)
			return 0
			;;
		*)
			log "e2fsck failed for /dev/$dev with exit code $rc"
			return "$rc"
			;;
	esac
}

repair_fs() {
	local dev="$1"
	local fstype="$2"

	if is_fat_type "$fstype"; then
		fsck_fat "$dev"
	elif is_ext_type "$fstype"; then
		fsck_ext "$dev"
	else
		log "unsupported filesystem type '$fstype' on /dev/$dev"
		return 1
	fi
}

probe_partitions() {
	local disk="$1"

	if [ -x "$partprobe_bin" ]; then
		"$partprobe_bin" "/dev/$disk" 2>/dev/null || true
	elif command -v partprobe >/dev/null 2>&1; then
		partprobe "/dev/$disk" 2>/dev/null || true
	fi
}

expand_data_partition() {
	local dev="$1"
	local disk
	local disk_sectors

	is_sd_data_part "$dev" || return 0
	is_mounted "$dev" && return 0
	disk="$(sd_parent_disk "$dev")"
	[ -b "/dev/$disk" ] || return 0
	[ -r "/sys/block/$disk/size" ] || return 0
	disk_sectors="$(cat "/sys/block/$disk/size" 2>/dev/null)"
	case "$disk_sectors" in
		""|*[!0-9]*)
			return 0
			;;
	esac

	python3 - "$disk" "$disk_sectors" <<'PY'
import struct
import sys

disk = sys.argv[1]
disk_sectors = int(sys.argv[2])
mbr_path = f"/dev/{disk}"
entry_offset = 446 + 16

with open(mbr_path, "r+b", buffering=0) as handle:
    handle.seek(0)
    mbr = bytearray(handle.read(512))
    if len(mbr) != 512 or mbr[510:512] != b"\x55\xaa":
        raise SystemExit(0)
    entry = mbr[entry_offset : entry_offset + 16]
    part_type = entry[4]
    if part_type not in (0x00, 0x83):
        raise SystemExit(0)
    start, size = struct.unpack_from("<II", entry, 8)
    if start <= 0 or start >= disk_sectors:
        raise SystemExit(0)
    desired = disk_sectors - start
    if desired <= size + 2048:
        raise SystemExit(0)
    struct.pack_into("<I", mbr, entry_offset + 12, desired)
    handle.seek(0)
    handle.write(mbr)
    handle.flush()
PY
	probe_partitions "$disk"
	sleep 1
}

format_data_partition() {
	local dev="$1"

	is_sd_data_part "$dev" || return 0
	if [ -x "$mke2fs_bin" ]; then
		"$mke2fs_bin" -t ext4 -L PLUTO_DATA -m 0 -O ^64bit -F "/dev/$dev"
	elif command -v mke2fs >/dev/null 2>&1; then
		mke2fs -t ext4 -L PLUTO_DATA -m 0 -O ^64bit -F "/dev/$dev"
	else
		log "mke2fs not available; cannot format /dev/$dev as ext4"
		return 1
	fi
}

resize_data_fs() {
	local dev="$1"

	is_sd_data_part "$dev" || return 0
	if [ -x "$resize2fs_bin" ]; then
		"$resize2fs_bin" "/dev/$dev" >/dev/null 2>&1 || true
	elif command -v resize2fs >/dev/null 2>&1; then
		resize2fs "/dev/$dev" >/dev/null 2>&1 || true
	fi
}

unmount_dev() {
	local dev="$1"

	if is_mounted "$dev"; then
		umount "$(mount_point "$dev")" || return 1
	fi

	return 0
}

mount_dev() {
	local dev="$1"
	local mp
	local opts
	local err
	local rc

	mp="$(mount_point "$dev")"
	opts="$(mount_opts "$dev")"
	mkdir -p "$mp" || return 1

	for _ in 1 2 3 4 5; do
		err=$(mount -t auto -o "$opts" "/dev/$dev" "$mp" 2>&1)
		rc=$?
		if [ "$rc" -eq 0 ]; then
			return 0
		fi
		if ! echo "$err" | grep -q "Device or resource busy"; then
			echo "$err" >&2
			return "$rc"
		fi
		sleep .25
	done

	echo "$err" >&2
	return "$rc"
}

prepare_dev() {
	local dev="$1"
	local fstype

	[ -b "/dev/$dev" ] || return 0
	if is_sd_boot_part "$dev"; then
		log "skipping SD boot partition /dev/$dev"
		return 0
	fi
	log "preparing /dev/$dev"

	if is_sd_part "$dev"; then
		expand_data_partition "$dev"
		fstype="$(blkid_fs_type "$dev")"
		if is_sd_data_part "$dev" && [ -z "$fstype" ]; then
			format_data_partition "$dev" || return 1
			fstype="$(blkid_fs_type "$dev")"
		fi
		if is_supported_type "$fstype"; then
			unmount_dev "$dev" || return 1
			repair_fs "$dev" "$fstype" || return 1
			if is_sd_data_part "$dev" && is_ext_type "$fstype"; then
				resize_data_fs "$dev"
			fi
		fi
	fi

	if ! is_mounted "$dev"; then
		if ! mount_dev "$dev"; then
			if is_sd_part "$dev" && is_supported_type "${fstype:-$(blkid_fs_type "$dev")}"; then
				repair_fs "$dev" "${fstype:-$(blkid_fs_type "$dev")}" || return 1
				mount_dev "$dev" || return 1
			else
				return 1
			fi
		fi
	fi

	if is_sd_part "$dev" && ! mount_is_rw "$dev" && is_supported_type "$(mounted_fs_type "$dev")"; then
		log "/dev/$dev mounted read-only; repairing and remounting"
		fstype="$(mounted_fs_type "$dev")"
		unmount_dev "$dev" || return 1
		repair_fs "$dev" "$fstype" || return 1
		mount_dev "$dev" || return 1
	fi

	if is_sd_part "$dev" && ! mount_is_rw "$dev"; then
		log "/dev/$dev is still read-only after repair"
		return 1
	fi

	log "/dev/$dev mounted at $(mount_point "$dev")"
	return 0
}

prepare_all_sd() {
	local found=0
	local dev

	for path in /dev/mmcblk[0-9]p[0-9] /dev/mmcblk[0-9]p[0-9][0-9]; do
		[ -b "$path" ] || continue
		found=1
		dev="$(basename "$path")"
		prepare_dev "$dev" || return 1
	done

	[ "$found" -eq 1 ] || return 0
}

case "$1" in
	--all|"")
		prepare_all_sd
		;;
	*)
		prepare_dev "$1"
		;;
esac
