#!/bin/sh

destdir=/media
blkid_bin="${BLKID:-/sbin/blkid}"
fsck_vfat_bin="${FSCK_VFAT:-/sbin/fsck.vfat}"
e2fsck_bin="${E2FSCK:-/sbin/e2fsck}"

log() {
	logger -t pluto-sdcard-prepare "$*"
}

is_sd_part() {
	case "$1" in
		mmcblk[0-9]p[0-9]|mmcblk[0-9]p[0-9][0-9])
			return 0
			;;
		*)
			return 1
			;;
	esac
}

is_mounted() {
	grep -qs "^/dev/$1 " /proc/mounts
}

mount_opts() {
	case "$1" in
		mmcblk*)
			echo noatime
			;;
		*)
			echo sync
			;;
	esac
}

mount_point() {
	echo "${destdir}/$1"
}

mount_is_rw() {
	local dev="$1"
	awk -v dev="/dev/$dev" '$1 == dev {
		split($4, opts, ",")
		for (i in opts) {
			if (opts[i] == "rw")
				found = 1
		}
	} END { exit found ? 0 : 1 }' /proc/mounts
}

mounted_fs_type() {
	local dev="$1"
	awk -v dev="/dev/$dev" '$1 == dev { print $3; exit }' /proc/mounts
}

blkid_fs_type() {
	local dev="$1"

	if [ -x "$blkid_bin" ]; then
		"$blkid_bin" "/dev/$dev" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'
	else
		blkid "/dev/$dev" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'
	fi
}

is_fat_type() {
	case "$1" in
		vfat|msdos|fat)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

is_ext_type() {
	case "$1" in
		ext2|ext3|ext4)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

is_supported_type() {
	is_fat_type "$1" || is_ext_type "$1"
}

fsck_fat() {
	local dev="$1"
	local rc

	if ! is_sd_part "$dev"; then
		return 0
	fi

	if [ ! -x "$fsck_vfat_bin" ] && ! command -v fsck.vfat >/dev/null 2>&1; then
		log "fsck.vfat not available; cannot repair /dev/$dev"
		return 1
	fi

	if [ -x "$fsck_vfat_bin" ]; then
		"$fsck_vfat_bin" -a "/dev/$dev"
	else
		fsck.vfat -a "/dev/$dev"
	fi
	rc=$?

	case "$rc" in
		0|1)
			return 0
			;;
		*)
			log "fsck.vfat failed for /dev/$dev with exit code $rc"
			return "$rc"
			;;
	esac
}

fsck_ext() {
	local dev="$1"
	local rc

	if ! is_sd_part "$dev"; then
		return 0
	fi

	if [ ! -x "$e2fsck_bin" ] && ! command -v e2fsck >/dev/null 2>&1; then
		log "e2fsck not available; cannot repair /dev/$dev"
		return 1
	fi

	if [ -x "$e2fsck_bin" ]; then
		"$e2fsck_bin" -p "/dev/$dev"
	else
		e2fsck -p "/dev/$dev"
	fi
	rc=$?

	case "$rc" in
		0|1|2)
			return 0
			;;
		*)
			log "e2fsck failed for /dev/$dev with exit code $rc"
			return "$rc"
			;;
	esac
}

repair_fs() {
	local dev="$1"
	local fstype="$2"

	if is_fat_type "$fstype"; then
		fsck_fat "$dev"
	elif is_ext_type "$fstype"; then
		fsck_ext "$dev"
	else
		log "unsupported filesystem type '$fstype' on /dev/$dev"
		return 1
	fi
}

unmount_dev() {
	local dev="$1"

	if is_mounted "$dev"; then
		umount "$(mount_point "$dev")" || return 1
	fi

	return 0
}

mount_dev() {
	local dev="$1"
	local mp
	local opts
	local err
	local rc

	mp="$(mount_point "$dev")"
	opts="$(mount_opts "$dev")"
	mkdir -p "$mp" || return 1

	for _ in 1 2 3 4 5; do
		err=$(mount -t auto -o "$opts" "/dev/$dev" "$mp" 2>&1)
		rc=$?
		if [ "$rc" -eq 0 ]; then
			return 0
		fi
		if ! echo "$err" | grep -q "Device or resource busy"; then
			echo "$err" >&2
			return "$rc"
		fi
		sleep .25
	done

	echo "$err" >&2
	return "$rc"
}

prepare_dev() {
	local dev="$1"
	local fstype

	[ -b "/dev/$dev" ] || return 0
	log "preparing /dev/$dev"

	if is_sd_part "$dev"; then
		fstype="$(blkid_fs_type "$dev")"
		if is_supported_type "$fstype"; then
			unmount_dev "$dev" || return 1
			repair_fs "$dev" "$fstype" || return 1
		fi
	fi

	if ! is_mounted "$dev"; then
		if ! mount_dev "$dev"; then
			if is_sd_part "$dev" && is_supported_type "${fstype:-$(blkid_fs_type "$dev")}"; then
				repair_fs "$dev" "${fstype:-$(blkid_fs_type "$dev")}" || return 1
				mount_dev "$dev" || return 1
			else
				return 1
			fi
		fi
	fi

	if is_sd_part "$dev" && ! mount_is_rw "$dev" && is_supported_type "$(mounted_fs_type "$dev")"; then
		log "/dev/$dev mounted read-only; repairing and remounting"
		fstype="$(mounted_fs_type "$dev")"
		unmount_dev "$dev" || return 1
		repair_fs "$dev" "$fstype" || return 1
		mount_dev "$dev" || return 1
	fi

	if is_sd_part "$dev" && ! mount_is_rw "$dev"; then
		log "/dev/$dev is still read-only after repair"
		return 1
	fi

	log "/dev/$dev mounted at $(mount_point "$dev")"
	return 0
}

prepare_all_sd() {
	local found=0
	local dev

	for path in /dev/mmcblk[0-9]p[0-9] /dev/mmcblk[0-9]p[0-9][0-9]; do
		[ -b "$path" ] || continue
		found=1
		dev="$(basename "$path")"
		prepare_dev "$dev" || return 1
	done

	[ "$found" -eq 1 ] || return 0
}

case "$1" in
	--all|"")
		prepare_all_sd
		;;
	*)
		prepare_dev "$1"
		;;
esac
