def clean_web_rel(value):
    rel = (value or "").strip()
    if rel in {"", "."}:
        return ""
    if rel.startswith("/") or ".." in Path(rel).parts:
        raise ApiError("bad_path", "file path is outside the selected root", status=400)
    if re.search(r"[`\"$\\;|&<>]", rel):
        raise ApiError("bad_path", "file path contains unsupported characters", status=400)
    return str(Path(rel))


def web_file_target(root_name, rel):
    base = WEB_FILE_ROOTS.get(root_name)
    if not base:
        raise ApiError("bad_root", "unknown file root", status=400)
    clean_rel = clean_web_rel(rel)
    target = base / clean_rel if clean_rel else base
    try:
        resolved_base = base.resolve()
        resolved_target = target.resolve()
    except OSError:
        resolved_base = base
        resolved_target = target
    try:
        common = os.path.commonpath([str(resolved_base), str(resolved_target)])
    except ValueError:
        common = ""
    if common != str(resolved_base):
        raise ApiError("bad_path", "file path is outside the selected root", status=400)
    return base, target, clean_rel


def web_file_type(path):
    if path.is_dir():
        return "dir"
    if path.is_symlink():
        return "link"
    if path.is_file():
        return "file"
    return "other"


def web_file_size(path):
