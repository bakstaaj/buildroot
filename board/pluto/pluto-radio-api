def run_cgi():
    method = os.environ.get("REQUEST_METHOD", "GET").upper()
    payload = read_request_body() if method in {"POST", "PUT", "PATCH"} else query_params()
    path = cgi_path()
    if method == "GET" and path in {"/radio/audio/live.pcm", "/audio/live.pcm"}:
        stream_audio("pcm", payload)
        return
    if method == "GET" and path in {"/radio/audio/live.wav", "/audio/live.wav"}:
        stream_audio("wav", payload)
        return
    if method == "GET" and path in {"/radio/spectrum/stream", "/spectrum/stream"}:
        spectrum_stream(payload)
        return
    if method == "GET" and path in {"/capture/download"}:
        download_capture(payload)
        return
    json_response(route(method, path, payload))


def run_cli(argv):
    if len(argv) < 2:
        raise ApiError("usage", "usage: pluto-radio-api serve|status|health|logs|profiles|apply|tune|stop|audio-start|audio-stop|audio-status|watchdog-status|watchdog-check|capture-start|capture-list|capture-delete|spectrum-status|spectrum-snapshot|spectrum-top|spectrum-stream|loopback-status|loopback-start|tx-status|tx-guardrails|tx-start|tx-stop|calibration-status|calibration-apply|self-test|self-test-status|doppler-status|doppler-plan|doppler-start|doppler-stop|doppler-tick", status=2)
    command = argv[1]
    if command == "serve":
        run_http_server(argv)
        raise SystemExit(0)
    if command == "status":
        return radio_status()
    if command == "health":
        return system_health()
    if command == "logs":
        params = {}
        if len(argv) > 2:
            params["source"] = argv[2]
        if len(argv) > 3:
            params["lines"] = argv[3]
        return system_logs(params)
    if command in {"profiles", "list-profiles"}:
        return list_profiles()
    if command == "apply":
        if len(argv) < 3:
            raise ApiError("usage", "usage: pluto-radio-api apply PROFILE [FREQUENCY_HZ]", status=2)
        payload = {"profile": argv[2]}
        if len(argv) > 3:
            payload["frequency_hz"] = argv[3]
        return apply_profile(payload)
    if command == "tune":
        if len(argv) < 3:
            raise ApiError("usage", "usage: pluto-radio-api tune FREQUENCY_HZ", status=2)
        return tune({"frequency_hz": argv[2]})
    if command == "stop":
        return stop_radio()
    if command == "audio-status":
        return audio_status()
    if command == "audio-start":
        payload = {}
        for arg in argv[2:]:
            if arg == "--simulate":
                payload["simulate"] = "true"
            elif "=" in arg:
                key, value = arg.split("=", 1)
                payload[key] = value
            elif "profile" not in payload:
                payload["profile"] = arg
        return start_audio(payload)
    if command == "audio-stop":
        return stop_audio()
    if command == "watchdog-status":
        return watchdog_status()
    if command == "watchdog-check":
        return watchdog_check()
    if command == "capture-list":
        return capture_list()
    if command == "capture-start":
        payload = {}
        if len(argv) > 2:
            payload["profile"] = argv[2]
        if "--simulate" in argv:
            payload["simulate"] = "true"
        return start_capture(payload)
    if command == "capture-delete":
        if len(argv) < 3:
            raise ApiError("usage", "usage: pluto-radio-api capture-delete CAPTURE_ID", status=2)
        return delete_capture({"capture_id": argv[2]})
    if command == "spectrum-status":
        return spectrum_status()
    if command == "spectrum-snapshot":
        payload = {"simulate": "true"} if "--simulate" in argv else {}
        if len(argv) > 2 and not argv[2].startswith("--"):
            payload["profile"] = argv[2]
        return spectrum_snapshot(payload)
    if command == "spectrum-top":
        payload = {"simulate": "true"} if "--simulate" in argv else {}
        if len(argv) > 2 and not argv[2].startswith("--"):
            payload["profile"] = argv[2]
        return spectrum_top(payload)
    if command == "spectrum-stream":
        payload = {}
        profile_set = False
        for arg in argv[2:]:
            if arg == "--simulate":
                payload["simulate"] = "true"
            elif "=" in arg:
                key, value = arg.split("=", 1)
                payload[key] = value
            elif not profile_set:
                payload["profile"] = arg
                profile_set = True
        spectrum_stream(payload)
        raise SystemExit(0)
    if command == "loopback-status":
        return loopback_status()
    if command == "loopback-start":
        payload = {"profile": "LOOPBACK_TEST"}
        profile_set = False
        for arg in argv[2:]:
            if arg == "--simulate":
                payload["simulate"] = "true"
            elif arg == "--confirm-live-tx":
                payload["confirm_live_tx"] = "true"
            elif "=" in arg:
                key, value = arg.split("=", 1)
                payload[key] = value
            elif not profile_set:
                payload["profile"] = arg
                profile_set = True
        return start_loopback(payload)
    if command == "tx-status":
        return tx_status()
    if command == "tx-guardrails":
        payload = {}
        profile_set = False
        for arg in argv[2:]:
            if arg == "--simulate":
                payload["simulate"] = "true"
            elif arg == "--confirm-live-tx":
                payload["confirm_live_tx"] = "true"
            elif "=" in arg:
                key, value = arg.split("=", 1)
                payload[key] = value
            elif not profile_set:
                payload["profile"] = arg
                profile_set = True
        return tx_guardrails(payload)
    if command == "tx-start":
        payload = {"profile": "TX_TEST_TONE"}
        profile_set = False
        for arg in argv[2:]:
            if arg == "--simulate":
                payload["simulate"] = "true"
            elif arg == "--confirm-live-tx":
                payload["confirm_live_tx"] = "true"
            elif "=" in arg:
                key, value = arg.split("=", 1)
                payload[key] = value
            elif not profile_set:
                payload["profile"] = arg
                profile_set = True
        return start_tx(payload)
    if command == "tx-stop":
        return stop_tx()
    if command == "calibration-status":
        return calibration_status()
    if command == "calibration-apply":
        payload = {}
        for arg in argv[2:]:
            if "=" not in arg:
                raise ApiError("usage", "usage: pluto-radio-api calibration-apply key=value ...", status=2)
            key, value = arg.split("=", 1)
            payload[key] = value
        return apply_calibration(payload)
    if command == "self-test":
        payload = {}
        for arg in argv[2:]:
            if "=" in arg:
                key, value = arg.split("=", 1)
                payload[key] = value
        return self_test(payload)
    if command == "self-test-status":
        return self_test_status()
    if command == "doppler-status":
        return doppler_status()
    if command == "doppler-plan":
        profile = argv[2] if len(argv) > 2 else "SAT_AUDIO_NFM"
        start_ms = int(time.time() * 1000)
        start_utc = datetime.fromtimestamp(start_ms / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        stop_utc = datetime.fromtimestamp((start_ms + 3000) / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        sample_plan = {
            "profile": profile,
            "base_frequency_hz": get_profile(profile)["default_frequency_hz"],
            "start_utc": start_utc,
            "stop_utc": stop_utc,
            "retune_interval_ms": 1000,
            "doppler_table": [
                {"offset_ms": 0, "frequency_hz": get_profile(profile)["default_frequency_hz"]},
                {"offset_ms": 1000, "frequency_hz": get_profile(profile)["default_frequency_hz"] + 100},
            ],
        }
        return doppler_plan(sample_plan)
    if command == "doppler-start":
        profile = argv[2] if len(argv) > 2 else "SAT_AUDIO_NFM"
        start_ms = int(time.time() * 1000)
        sample_plan = {
            "profile": profile,
            "base_frequency_hz": get_profile(profile)["default_frequency_hz"],
            "start_utc": datetime.fromtimestamp(start_ms / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "stop_utc": datetime.fromtimestamp((start_ms + 3000) / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "retune_interval_ms": 1000,
            "doppler_table": [
                {"offset_ms": 0, "frequency_hz": get_profile(profile)["default_frequency_hz"]},
                {"offset_ms": 1000, "frequency_hz": get_profile(profile)["default_frequency_hz"] + 100},
            ],
        }
        return doppler_start(sample_plan)
    if command == "doppler-stop":
        return doppler_stop()
    if command == "doppler-tick":
        payload = {}
        if len(argv) > 2:
            payload["now_ms"] = argv[2]
        if dry_run():
            payload.update(
                {
                    "profile": "SAT_AUDIO_NFM",
                    "base_frequency_hz": get_profile("SAT_AUDIO_NFM")["default_frequency_hz"],
                    "start_utc": now_utc(),
                    "stop_utc": datetime.fromtimestamp(time.time() + 3, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "doppler_table": [{"offset_ms": 0, "frequency_hz": get_profile("SAT_AUDIO_NFM")["default_frequency_hz"]}],
                }
            )
        return doppler_tick(payload)
    raise ApiError("usage", f"unknown command {command}", status=2)


def main():
    try:
        if is_cgi():
            run_cgi()
        else:
            json_response(run_cli(sys.argv))
    except ApiError as exc:
        if exc.code.startswith("audio_"):
            fail_audio_state(exc.code, exc.message)
        fail_state(exc.code, exc.message)
        json_response({"ok": False, "error": exc.code, "message": exc.message, "details": exc.details}, exc.status)
        if not is_cgi():
            sys.exit(1 if exc.status >= 400 else exc.status)
    except Exception as exc:
        fail_state("internal_error", str(exc))
        json_response({"ok": False, "error": "internal_error", "message": str(exc)}, 500)
        if not is_cgi():
            sys.exit(1)


if __name__ == "__main__":
    main()
