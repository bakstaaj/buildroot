    finally:
        if tx_proc and tx_proc.poll() is None:
            tx_proc.terminate()
        if audio_proc and audio_proc.poll() is None:
            audio_proc.terminate()
            try:
                audio_proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                audio_proc.kill()
        if log:
            log.close()
        clear_audio_backend_status()
        save_audio_state(**stopped_audio_updates())
        try:
            write_attr(find_iio_device(), "ensm_mode", "alert")
        except Exception:
            pass


