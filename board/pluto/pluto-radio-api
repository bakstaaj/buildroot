def send_http_json(handler, payload, status=200):
    body = (json.dumps(payload, sort_keys=True) + "\n").encode("utf-8")
    handler.send_response(status)
    handler.send_header("Content-Type", "application/json")
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Length", str(len(body)))
    handler.end_headers()
    handler.wfile.write(body)


def stream_audio_http(handler, format_name, params):
    status = audio_status()["audio"]
    if status["state"] != "running":
        raise ApiError("audio_not_running", "audio stream is not running", status=409)
    if dry_run():
        raise ApiError("audio_stream_unavailable", "audio streaming is unavailable in dry-run mode", status=503)
    rate = int(status.get("audio_rate_hz") or 48000)
    bytes_remaining = audio_stream_length(params, rate)
    handler.send_response(200)
    handler.send_header("Content-Type", "audio/L16" if format_name == "pcm" else "audio/wav")
    handler.send_header("Cache-Control", "no-store")
    if bytes_remaining is not None:
        content_length = bytes_remaining + (44 if format_name == "wav" else 0)
        handler.send_header("Content-Length", str(content_length))
    handler.end_headers()
    if format_name == "wav":
        handler.wfile.write(wav_header(audio_stream_wav_data_bytes(bytes_remaining), rate))
        handler.wfile.flush()
    fd = os.open(str(AUDIO_FIFO), os.O_RDONLY | os.O_NONBLOCK)
    try:
        first_chunk_seen = bytes_remaining is None
        startup_deadline = None if bytes_remaining is None else time.time() + 5.0
        stream_deadline = None
        while bytes_remaining is None or bytes_remaining > 0:
            now = time.time()
            if not first_chunk_seen:
                if startup_deadline is not None and now >= startup_deadline:
                    break
            elif stream_deadline is not None and now >= stream_deadline:
                break
            if bytes_remaining is None and not process_alive(status.get("pid")):
                break
            read_size = 16384 if bytes_remaining is None else min(16384, bytes_remaining)
            chunk = read_audio_fifo_chunk(fd, read_size)
            if chunk is None:
                continue
            if not chunk:
                time.sleep(0.002)
                continue
            if bytes_remaining is not None and not first_chunk_seen:
                first_chunk_seen = True
                expected_seconds = bytes_remaining / max(1, rate * 2)
                stream_deadline = time.time() + max(1.0, expected_seconds + 1.0)
            try:
                handler.wfile.write(chunk)
                handler.wfile.flush()
            except (BrokenPipeError, ConnectionResetError, OSError):
                break
            if bytes_remaining is not None:
                bytes_remaining -= len(chunk)
    finally:
        os.close(fd)


