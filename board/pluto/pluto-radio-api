    if state.get("requested_frequency_hz") and not dry_run():
        applied = tune({"frequency_hz": state["requested_frequency_hz"]})
    return {"ok": True, "calibration": saved, "applied_to_hardware": applied is not None, "applied": applied}


def truthy(value):
    if isinstance(value, bool):
        return value
    return str(value).lower() in {"1", "true", "yes", "on"}


def median_number(values):
    ordered = sorted(values)
    count = len(ordered)
    if count == 0:
        return None
    mid = count // 2
    if count % 2:
        return ordered[mid]
    return (ordered[mid - 1] + ordered[mid]) / 2.0


def measure_rx_calibration(payload):
    profile = get_profile(payload.get("profile", load_state().get("active_profile") or "NOAA_NFM"))
    reference_hz = validate_uint(
        payload.get("reference_frequency_hz", payload.get("frequency_hz", profile["default_frequency_hz"])),
        "reference_frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    span_hz = validate_uint(payload.get("span_hz", 50_000), "span_hz", 1_000, 1_000_000)
    search_hz = validate_uint(payload.get("search_hz", min(span_hz // 2, 25_000)), "search_hz", 100, span_hz // 2)
    bins = validate_uint(payload.get("bins", min(SPECTRUM_MAX_BINS, 1024)), "bins", 64, SPECTRUM_MAX_BINS)
    measurements = validate_uint(payload.get("measurements", payload.get("duration_seconds", 3)), "measurements", 1, 10)
    min_snr_db = validate_decimal(payload.get("min_snr_db", 8.0), "min_snr_db", 0.0, 80.0)
    apply_result = truthy(payload.get("apply", False))
    simulate = dry_run() or truthy(payload.get("simulate", False))

    if audio_status()["audio"].get("state") == "running" and not simulate:
        stop_audio()

    current_offset = float(load_calibration_state().get("rx_frequency_offset_hz", 0.0))
    request = {
        "profile": profile["name"],
        "frequency_hz": reference_hz,
        "center_frequency_hz": reference_hz,
        "span_hz": span_hz,
        "bins": bins,
        "top_n": min(10, SPECTRUM_MAX_TOP_N),
    }
    for key in ("gain_db", "gain_control_mode"):
        if key in payload:
            request[key] = payload[key]
    if simulate:
        request["simulate"] = "true"

    samples = []
    rejected = []
    for index in range(measurements):
        snapshot = spectrum_snapshot(dict(request))["spectrum"]
        candidates = []
        for peak in snapshot.get("peaks", []):
            try:
                peak_frequency = int(peak.get("frequency_hz"))
                power_dbfs = float(peak.get("power_dbfs", -120.0))
                snr_db = float(peak.get("snr_db", 0.0))
            except (TypeError, ValueError):
                continue
            measured_peak_offset = peak_frequency - reference_hz
            if abs(measured_peak_offset) <= search_hz:
                candidates.append(
                    {
                        "frequency_hz": peak_frequency,
                        "measured_peak_offset_hz": measured_peak_offset,
                        "power_dbfs": power_dbfs,
                        "snr_db": snr_db,
                    }
                )
        if not candidates:
            rejected.append({"measurement": index + 1, "reason": "no_peak_in_search_window", "peaks": snapshot.get("peaks", [])[:5]})
            continue
        best = sorted(candidates, key=lambda item: item["power_dbfs"], reverse=True)[0]
        if best["snr_db"] < min_snr_db:
            rejected.append({"measurement": index + 1, "reason": "snr_below_minimum", "peak": best})
            continue
        best["measurement"] = index + 1
        samples.append(best)

    if not samples:
        raise ApiError(
            "calibration_reference_not_found",
            "no suitable reference carrier peak was found near the requested frequency",
            status=503,
            details={
                "reference_frequency_hz": reference_hz,
                "span_hz": span_hz,
                "search_hz": search_hz,
                "min_snr_db": min_snr_db,
                "rejected": rejected,
            },
        )

    measured_offsets = [sample["measured_peak_offset_hz"] for sample in samples]
    measured_peak_offset = median_number(measured_offsets)
    recommended_offset = current_offset + measured_peak_offset
    if recommended_offset < -250_000.0 or recommended_offset > 250_000.0:
        raise ApiError(
            "calibration_offset_out_of_range",
            "recommended rx_frequency_offset_hz is outside the supported calibration range",
            status=422,
            details={
                "current_rx_frequency_offset_hz": current_offset,
                "measured_peak_offset_hz": measured_peak_offset,
                "recommended_rx_frequency_offset_hz": recommended_offset,
            },
        )

    bin_width_hz = span_hz / max(1, bins - 1)
    spread_hz = max(measured_offsets) - min(measured_offsets) if len(measured_offsets) > 1 else 0
    best_snr = max(sample["snr_db"] for sample in samples)
    if len(samples) < measurements or best_snr < min_snr_db + 3.0:
        confidence = "low"
    elif spread_hz > max(250.0, bin_width_hz * 4.0):
        confidence = "medium"
    else:
        confidence = "high"

    applied = None
    if apply_result:
        current = load_calibration_state()
        applied = apply_calibration(
            {
                "rx_frequency_offset_hz": recommended_offset,
                "tx_frequency_offset_hz": current.get("tx_frequency_offset_hz", 0.0),
                "rx_gain_offset_db": current.get("rx_gain_offset_db", 0.0),
                "tx_gain_offset_db": current.get("tx_gain_offset_db", 0.0),
                "notes": payload.get("notes", f"RX calibrated from {reference_hz} Hz reference"),
            }
        )

    return {
        "ok": True,
        "calibration_measurement": {
            "profile": profile["name"],
            "reference_frequency_hz": reference_hz,
            "span_hz": span_hz,
            "search_hz": search_hz,
            "bins": bins,
            "bin_width_hz": bin_width_hz,
            "measurements_requested": measurements,
            "measurements_used": len(samples),
            "current_rx_frequency_offset_hz": current_offset,
            "measured_peak_offset_hz": measured_peak_offset,
            "recommended_rx_frequency_offset_hz": recommended_offset,
            "confidence": confidence,
            "samples": samples,
            "rejected": rejected,
            "applied": applied,
        },
    }


def tx_backend_path():
    if TX_BACKEND.is_file() and os.access(str(TX_BACKEND), os.X_OK):
        return TX_BACKEND
    if LOOPBACK_BACKEND.is_file() and os.access(str(LOOPBACK_BACKEND), os.X_OK):
        return LOOPBACK_BACKEND
    return TX_BACKEND


def apply_tx_config(plan):
    profile = plan["profile"]
    apply_profile(
        {
            "profile": profile["name"],
            "frequency_hz": plan["frequency_hz"],
            "gain_db": plan["gain_db"],
            "gain_control_mode": profile["gain_control_mode"],
        }
    )
    device = find_iio_device()
    sample_rate_hz = validate_device_sample_rate(device, "out", plan["sample_rate_hz"])
    writes = [
        write_attr(device, "out_altvoltage1_TX_LO_frequency", plan["frequency_hz"], required=True),
        write_attr(device, "out_voltage_rf_bandwidth", plan["rf_bandwidth_hz"], required=True),
        write_attr(device, "out_voltage_sampling_frequency", sample_rate_hz, required=True),
        write_attr(device, "out_voltage0_hardwaregain", plan["tx_gain_db"], required=True),
        write_attr(device, "out_voltage1_hardwaregain", plan["tx_gain_db"]),
        write_attr(device, "ensm_mode", "fdd"),
    ]
    return writes


