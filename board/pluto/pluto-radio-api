def parse_utc(value, key):
    if not isinstance(value, str) or not value:
        raise ApiError("invalid_time", f"{key} is required", details={key: value})
    try:
        normalized = value.replace("Z", "+00:00")
        parsed = datetime.fromisoformat(normalized)
    except ValueError:
        raise ApiError("invalid_time", f"{key} must be ISO-8601 UTC", details={key: value})
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=timezone.utc)
    return parsed.astimezone(timezone.utc)


def utc_epoch_ms(value):
    return int(parse_utc(value, "time").timestamp() * 1000)


def validate_doppler_point(point, index):
    if not isinstance(point, dict):
        raise ApiError("invalid_doppler_point", "doppler_table entries must be objects", details={"index": index})
    offset_ms = validate_uint(point.get("offset_ms"), "offset_ms", 0, 24 * 60 * 60 * 1000)
    frequency_hz = validate_uint(point.get("frequency_hz"), "frequency_hz", 70_000_000, 6_000_000_000)
    return {"offset_ms": offset_ms, "frequency_hz": frequency_hz}


def validate_doppler_plan(payload):
    profile = get_profile(payload.get("profile", ""))
    base_frequency_hz = validate_uint(
        payload.get("base_frequency_hz", profile["default_frequency_hz"]),
        "base_frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    start_utc = payload.get("start_utc")
    stop_utc = payload.get("stop_utc")
    if not start_utc:
        start_utc = now_utc()
    start_dt = parse_utc(start_utc, "start_utc")
    if not stop_utc:
        stop_dt = datetime.fromtimestamp(start_dt.timestamp() + 900, timezone.utc)
        stop_utc = stop_dt.strftime("%Y-%m-%dT%H:%M:%SZ")
    else:
        stop_dt = parse_utc(stop_utc, "stop_utc")
    if stop_dt <= start_dt:
        raise ApiError("invalid_doppler_plan", "stop_utc must be after start_utc")
    retune_interval_ms = validate_uint(
        payload.get("retune_interval_ms", 1000),
        "retune_interval_ms",
        DOPPLER_MIN_INTERVAL_MS,
        60_000,
    )
    table = payload.get("doppler_table")
    if not isinstance(table, list) or not table:
        table = [{"offset_ms": 0, "frequency_hz": base_frequency_hz}]
    if len(table) > DOPPLER_MAX_POINTS:
        raise ApiError("doppler_table_too_large", "doppler table exceeds maximum points", details={"max_points": DOPPLER_MAX_POINTS})
    clean_table = [validate_doppler_point(point, idx) for idx, point in enumerate(table)]
    clean_table.sort(key=lambda point: point["offset_ms"])
    return {
        "profile": profile["name"],
        "base_frequency_hz": base_frequency_hz,
        "start_utc": start_dt.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "stop_utc": stop_dt.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "retune_interval_ms": retune_interval_ms,
        "doppler_table": clean_table,
        "point_count": len(clean_table),
        "start_epoch_ms": int(start_dt.timestamp() * 1000),
        "stop_epoch_ms": int(stop_dt.timestamp() * 1000),
    }


def doppler_plan(payload):
    plan = validate_doppler_plan(payload)
    if dry_run():
        return {"ok": True, "doppler": {"state": "planned", "plan": plan, "dry_run": True}}
    save_doppler_state(
        state="planned",
        plan=plan,
        current_index=0,
        worker_pid=None,
        last_retune_utc=None,
        last_error=None,
    )
    apply_profile({"profile": plan["profile"], "frequency_hz": plan["base_frequency_hz"]})
    return doppler_status()


def doppler_status():
    state = load_doppler_state()
    plan = state.get("plan")
    worker_pid = state.get("worker_pid")
    current_index = int(state.get("current_index") or 0)
    next_point = None
    if plan:
        table = plan.get("doppler_table", [])
        if current_index < len(table):
            point = table[current_index]
            next_point = {
                "offset_ms": point["offset_ms"],
                "frequency_hz": point["frequency_hz"],
                "retune_utc": datetime.fromtimestamp((plan["start_epoch_ms"] + point["offset_ms"]) / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            }
    return {
        "ok": True,
        "doppler": {
            "state": state.get("state", "idle"),
            "profile": plan.get("profile") if plan else None,
            "point_count": plan.get("point_count") if plan else 0,
            "current_index": current_index,
            "next_point": next_point,
            "current_frequency_hz": state.get("current_frequency_hz"),
            "actual_frequency_hz": radio_status()["radio"].get("actual_frequency_hz"),
            "worker_pid": worker_pid,
            "worker_alive": process_alive(worker_pid),
            "last_retune_utc": state.get("last_retune_utc"),
            "last_error": state.get("last_error"),
            "max_points": DOPPLER_MAX_POINTS,
            "min_interval_ms": DOPPLER_MIN_INTERVAL_MS,
        },
    }


def doppler_start(payload):
    plan_response = None
    if payload.get("profile"):
        plan_response = doppler_plan(payload)
    state = load_doppler_state()
    plan = state.get("plan") or (plan_response or {}).get("doppler", {}).get("plan")
    if not plan:
        raise ApiError("no_doppler_plan", "load a Doppler plan before starting", status=409)
    if dry_run():
        return {"ok": True, "doppler": {"state": "running", "plan": plan, "dry_run": True}}
    worker_pid = state.get("worker_pid")
    if process_alive(worker_pid):
        return doppler_status()
    if not DOPPLER_WORKER.is_file() or not os.access(str(DOPPLER_WORKER), os.X_OK):
        raise ApiError("doppler_worker_missing", f"Doppler worker is not installed: {DOPPLER_WORKER}", status=503)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    log = (STATE_DIR / "doppler-worker.log").open("ab")
    proc = subprocess.Popen([str(DOPPLER_WORKER)], stdin=subprocess.DEVNULL, stdout=log, stderr=log)
    save_doppler_state(state="running", worker_pid=proc.pid, last_error=None)
    return doppler_status()


def doppler_stop():
    state = load_doppler_state()
    pid = state.get("worker_pid")
    if process_alive(pid) and os.name != "nt":
        try:
            os.kill(int(pid), signal.SIGTERM)
        except OSError:
            pass
    if dry_run():
        return {"ok": True, "doppler": {"state": "stopped", "dry_run": True}}
    save_doppler_state(state="stopped", worker_pid=None)
    return doppler_status()


def doppler_tick(payload=None):
    payload = payload or {}
    if dry_run() and payload.get("profile"):
        plan = validate_doppler_plan(payload)
        return {"ok": True, "doppler": {"state": "running", "plan": plan, "dry_run": True}, "applied": None}
    state = load_doppler_state()
    plan = state.get("plan")
    if not plan:
        raise ApiError("no_doppler_plan", "no Doppler plan is loaded", status=409)
    now_ms = int(payload.get("now_ms") or time.time() * 1000)
    if now_ms >= plan["stop_epoch_ms"]:
        if not dry_run():
            save_doppler_state(state="complete", worker_pid=None)
        return doppler_status()

    table = plan.get("doppler_table", [])
    current_index = int(state.get("current_index") or 0)
    applied = None
    while current_index < len(table) and now_ms >= plan["start_epoch_ms"] + table[current_index]["offset_ms"]:
        applied = table[current_index]
        current_index += 1
    if applied:
        tune({"frequency_hz": applied["frequency_hz"]})
        updates = {
            "state": "running",
            "current_index": current_index,
            "current_frequency_hz": applied["frequency_hz"],
            "last_retune_utc": now_utc(),
            "last_error": None,
        }
        if not dry_run():
            save_doppler_state(**updates)
        return {"ok": True, "doppler": doppler_status()["doppler"], "applied": applied}

    return {"ok": True, "doppler": doppler_status()["doppler"], "applied": None}


def wav_header(data_bytes, rate):
    channels = 1
    bits = 16
    byte_rate = rate * channels * bits // 8
    block_align = channels * bits // 8
    return (
        b"RIFF"
        + int(36 + data_bytes).to_bytes(4, "little")
        + b"WAVEfmt "
        + int(16).to_bytes(4, "little")
        + int(1).to_bytes(2, "little")
        + int(channels).to_bytes(2, "little")
        + int(rate).to_bytes(4, "little")
        + int(byte_rate).to_bytes(4, "little")
        + int(block_align).to_bytes(2, "little")
        + int(bits).to_bytes(2, "little")
        + b"data"
        + int(data_bytes).to_bytes(4, "little")
    )

def audio_stream_continuous(params):
    raw = params.get("continuous", False)
    if isinstance(raw, bool) and raw:
        return True
    if str(raw).lower() in {"1", "true", "yes", "on"}:
        return True
    if "seconds" not in params:
        return True
    return str(params.get("seconds", "")) == "0"


