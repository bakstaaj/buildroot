    duration_max = max(1, min(profile_limit, TX_MAX_SECONDS))
    duration_seconds = validate_uint(payload.get("duration_seconds", duration_max), "duration_seconds", 1, duration_max)
    frequency_hz = validate_uint(
        payload.get("frequency_hz", profile["default_frequency_hz"]),
        "frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    tx_mode = payload.get("tx_mode", profile.get("tx_mode", "tone"))
    if tx_mode not in TX_MODES:
        raise ApiError("invalid_value", "tx_mode is invalid", details={"tx_mode": tx_mode})
    default_tone = 0 if tx_mode in {"carrier", "am", "fm", "cw", "ft8"} else profile.get("tx_tone_hz", 10000)
    tx_tone_hz = validate_uint(payload.get("tx_tone_hz", default_tone), "tx_tone_hz", 0, 200000)
    if tx_mode == "tone" and tx_tone_hz < 100:
        raise ApiError("invalid_tx_tone", "tone TX requires tx_tone_hz >= 100", details={"tx_tone_hz": tx_tone_hz})
    if tx_mode in {"carrier", "am", "fm", "cw", "ft8"}:
        tx_tone_hz = 0
    tx_audio_source = payload.get("tx_audio_source", profile.get("tx_audio_source", "tone"))
    if tx_audio_source not in TX_AUDIO_SOURCES:
        raise ApiError("invalid_value", "tx_audio_source is invalid", details={"tx_audio_source": tx_audio_source})
    tx_audio_path = payload.get("tx_audio_path", profile.get("tx_audio_path", ""))
    if tx_audio_source == "file":
        tx_audio_path = validate_tx_audio_path(tx_audio_path)
    else:
        tx_audio_path = ""
    tx_audio_rate_hz = validate_uint(
        payload.get("tx_audio_rate_hz", profile.get("tx_audio_rate_hz", 8000)), "tx_audio_rate_hz", 8000, 48000
    )
    tx_audio_tone_hz = validate_uint(
        payload.get("tx_audio_tone_hz", profile.get("tx_audio_tone_hz", 1000)), "tx_audio_tone_hz", 20, 3000
    )
    tx_am_modulation_index = validate_decimal(
        payload.get("tx_am_modulation_index", profile.get("tx_am_modulation_index", 0.8)),
        "tx_am_modulation_index",
        0.0,
        1.0,
    )
    tx_fm_deviation_hz = validate_uint(
        payload.get("tx_fm_deviation_hz", profile.get("tx_fm_deviation_hz", 5000)), "tx_fm_deviation_hz", 100, 25000
    )
    tx_cw_text = validate_cw_text(payload.get("tx_cw_text", profile.get("tx_cw_text", "CQ PLUTO")))
    tx_cw_wpm = validate_uint(payload.get("tx_cw_wpm", profile.get("tx_cw_wpm", 12)), "tx_cw_wpm", 5, 40)
    tx_ft8_text = validate_ft8_text(payload.get("tx_ft8_text", profile.get("tx_ft8_text", "CQ K1ABC FN42")))
    tx_gain_db = validate_decimal(payload.get("tx_gain_db", profile.get("tx_gain_db", -30.0)), "tx_gain_db", -89.75, 0.0)
    tx_amplitude = validate_decimal(
        payload.get("tx_amplitude", profile.get("tx_amplitude", 0.05)),
        "tx_amplitude",
        0.0,
        TX_MAX_TX_AMPLITUDE,
    )
    sample_rate_hz = validate_uint(
        payload.get("sample_rate_hz", profile["sample_rate_hz"]),
        "sample_rate_hz",
        MIN_AD9361_SAMPLE_RATE_HZ,
        MAX_AD9361_SAMPLE_RATE_HZ,
        )
    if tx_tone_hz and tx_tone_hz >= sample_rate_hz // 4:
        raise ApiError(
            "invalid_tx_tone",
            "tx_tone_hz must be below one quarter of sample_rate_hz",
            details={"tx_tone_hz": tx_tone_hz, "sample_rate_hz": sample_rate_hz},
        )
    if tx_mode in {"am", "fm"} and tx_audio_source == "file" and not tx_audio_path:
        raise ApiError("invalid_audio_path", "tx_audio_path is required for file audio source")
    if tx_fm_deviation_hz >= sample_rate_hz // 8:
        raise ApiError(
            "invalid_fm_deviation",
            "tx_fm_deviation_hz must be below one eighth of sample_rate_hz",
            details={"tx_fm_deviation_hz": tx_fm_deviation_hz, "sample_rate_hz": sample_rate_hz},
        )
    return {
        "profile": profile,
        "frequency_hz": frequency_hz,
        "duration_seconds": duration_seconds,
        "tx_mode": tx_mode,
        "tx_gain_db": tx_gain_db,
        "tx_tone_hz": tx_tone_hz,
        "tx_amplitude": tx_amplitude,
        "tx_audio_source": tx_audio_source,
        "tx_audio_path": tx_audio_path,
        "tx_audio_rate_hz": tx_audio_rate_hz,
        "tx_audio_tone_hz": tx_audio_tone_hz,
        "tx_am_modulation_index": tx_am_modulation_index,
        "tx_fm_deviation_hz": tx_fm_deviation_hz,
        "tx_cw_text": tx_cw_text,
        "tx_cw_wpm": tx_cw_wpm,
        "tx_ft8_text": tx_ft8_text,
        "sample_rate_hz": sample_rate_hz,
        "rf_bandwidth_hz": profile["rf_bandwidth_hz"],
        "gain_db": profile["gain_db"],
    }


