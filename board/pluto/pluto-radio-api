        try:
            target_bytes = int(capture_seconds * audio_rate * 2)
            pcm = read_fifo_bounded(fifo, target_bytes, capture_seconds + 3)
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=2)
            log.flush()
            status_path = Path(tmpdir) / "audio-backend-status.json"
            backend_status = read_json_file(status_path, {})
            message = (Path(tmpdir) / "audio-backend.log").read_text(encoding="utf-8", errors="replace")[-500:]
            if len(pcm) < target_bytes:
                raise ApiError(
                    "demod_self_test_timeout",
                    "demod self-test did not produce the requested PCM before the bounded deadline",
                    status=503,
                    details={
                        "pcm_bytes": len(pcm),
                        "target_bytes": target_bytes,
                        "backend_returncode": proc.returncode,
                        "backend_status": backend_status,
                        "backend_log_tail": message,
                    },
                )
            if proc.returncode not in (0, -signal.SIGTERM, None):
                raise ApiError(
                    "demod_self_test_failed",
                    message or "audio backend failed",
                    status=503,
                    details={"returncode": proc.returncode, "backend_status": backend_status},
                )
        finally:
            if proc.poll() is None:
                proc.terminate()
            log.close()

        metrics = pcm_s16le_metrics(pcm, audio_rate, tone_hz)
        return {
            "ok": True,
            "demod_self_test": {
                "profile": profile["name"],
                "source": "synthetic_fm",
                "duration_seconds": duration_seconds,
                "capture_seconds": capture_seconds,
                "tone_hz": tone_hz,
                "fm_deviation_hz": fm_deviation_hz,
                "carrier_hz": carrier_hz,
                "frequency_shift_hz": frequency_shift_hz,
                "metrics": metrics,
            },
            "bounded": True,
        }


def self_test_step(name, func, required=True):
    try:
        result = func()
        ok = result.get("ok", True) if isinstance(result, dict) else True
        if isinstance(result, dict):
            for key in ("loopback_cw", "loopback_demod", "demod_self_test", "loopback"):
                nested = result.get(key)
                if not isinstance(nested, dict):
                    continue
                metrics = nested.get("metrics")
                if isinstance(metrics, dict) and metrics.get("passed") is False:
                    ok = False
                if isinstance(metrics, dict) and metrics.get("ok") is False:
                    ok = False
        return {"name": name, "ok": bool(ok), "required": required, "result": result}
    except ApiError as exc:
        return {
            "name": name,
            "ok": False,
            "required": required,
            "error": {"code": exc.code, "message": exc.message, "details": exc.details},
        }
    except Exception as exc:
        return {"name": name, "ok": False, "required": required, "error": {"code": "internal_error", "message": str(exc)}}


