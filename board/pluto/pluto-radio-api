    current = load_calibration_state()
    calibration = {
        "rx_frequency_offset_hz": validate_optional_decimal(
            payload, "rx_frequency_offset_hz", current.get("rx_frequency_offset_hz", 0.0), -250_000.0, 250_000.0
        ),
        "tx_frequency_offset_hz": validate_optional_decimal(
            payload, "tx_frequency_offset_hz", current.get("tx_frequency_offset_hz", 0.0), -250_000.0, 250_000.0
        ),
        "rx_gain_offset_db": validate_optional_decimal(
            payload, "rx_gain_offset_db", current.get("rx_gain_offset_db", 0.0), -20.0, 20.0
        ),
        "tx_gain_offset_db": validate_optional_decimal(
            payload, "tx_gain_offset_db", current.get("tx_gain_offset_db", 0.0), -20.0, 20.0
        ),
        "notes": validate_notes(payload.get("notes", current.get("notes", ""))),
    }
    saved = save_calibration_state(**calibration)
    applied = None
