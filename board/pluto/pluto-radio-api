    ]
    if live_loopback:
        for wpm in self_test_cw_wpm_values(payload):
            steps.append(
                self_test_step(
                    f"loopback-cw-{wpm}wpm",
                    lambda wpm=wpm: start_loopback_cw(self_test_cw_loopback_payload(payload, wpm)),
                )
            )
        steps.append(self_test_step("tx-stop-after-loopback", stop_tx))
    if live_spectrum:
        steps.append(
            self_test_step(
                "spectrum-live-stream",
                lambda: spectrum_stream_collect(self_test_spectrum_live_payload(payload)),
                required=require_radio,
            )
        )
    required_failures = [step for step in steps if step["required"] and not step["ok"]]
    optional_failures = [step for step in steps if not step["required"] and not step["ok"]]
    state = "fail" if required_failures else "warn" if optional_failures else "pass"
    saved = save_self_test_state(
        state=state,
        safe=not live_loopback,
        live_tx=live_loopback,
        required_failures=len(required_failures),
        optional_failures=len(optional_failures),
        completed_utc=now_utc(),
    )
    return {
        "ok": not required_failures,
        "self_test": {
            "state": state,
            "safe": not live_loopback,
            "live_tx": live_loopback,
            "steps": steps,
            "required_failures": len(required_failures),
            "optional_failures": len(optional_failures),
            "last_result": saved,
        },
    }


