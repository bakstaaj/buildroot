    translation_hz = validate_uint(payload.get("frequency_translation_hz", 125_000_000), "frequency_translation_hz", 0, 6_000_000_000)
    hardware_frequency_hz = source_frequency_hz + translation_hz
    if hardware_frequency_hz < 70_000_000 or hardware_frequency_hz > 6_000_000_000:
        raise ApiError("invalid_frequency_translation", "translated FT8 frequency is outside the AD9361 tuning range")
    attenuator_db = validate_decimal(payload.get("attenuator_db", 30), "attenuator_db", 30, 120)
    if not tx_confirmation(payload):
        raise ApiError("tx_confirmation_required", "set confirm_live_tx=true to run bounded live RF FT8 loopback", status=403)

    rx_profile = get_profile(payload.get("rx_profile", "FT8_40M_LOOPBACK"))
    demod, audio_rate = audio_capable_profile(rx_profile)
    if demod != "ft8" or audio_rate != 12_000:
        raise ApiError("invalid_rx_profile", "FT8 loopback requires a 12 kHz FT8 receive profile")
    tx_payload = dict(payload)
    tx_payload.update({
        "profile": payload.get("tx_profile", "TX_FT8_LOOPBACK"),
        "frequency_hz": hardware_frequency_hz,
        "tx_mode": "ft8",
    })
    tx_payload.setdefault("duration_seconds", 30)
    tx_payload.setdefault("tx_gain_db", -40)
    tx_payload.setdefault("tx_amplitude", 0.05)
