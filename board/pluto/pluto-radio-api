            plan = tx_plan_summary(validate_tx(payload))
    except ApiError as exc:
        error = {"code": exc.code, "message": exc.message, "details": exc.details}
    readiness = tx_readiness(payload)
    return {
        "ok": error is None,
        "guardrails": tx_guardrail_bounds(),
        "plan": plan,
        "readiness": readiness,
        "error": error,
    }


