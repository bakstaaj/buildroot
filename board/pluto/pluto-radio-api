def start_tx(payload):
    plan = validate_tx(payload)
    simulate = dry_run() or str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}
    if not simulate and not tx_confirmation(payload):
        raise ApiError(
            "tx_confirmation_required",
            "set confirm_live_tx=true to run bounded live RF TX",
            status=403,
        )

    started = now_utc()
    save_tx_state(
        state="running",
        profile=plan["profile"]["name"],
        frequency_hz=plan["frequency_hz"],
        duration_seconds=plan["duration_seconds"],
        tx_mode=plan["tx_mode"],
        tx_gain_db=plan["tx_gain_db"],
        tx_tone_hz=plan["tx_tone_hz"],
        tx_amplitude=plan["tx_amplitude"],
        tx_audio_source=plan["tx_audio_source"],
        tx_audio_path=plan["tx_audio_path"],
        tx_audio_rate_hz=plan["tx_audio_rate_hz"],
        tx_audio_tone_hz=plan["tx_audio_tone_hz"],
        tx_am_modulation_index=plan["tx_am_modulation_index"],
        tx_fm_deviation_hz=plan["tx_fm_deviation_hz"],
        tx_cw_text=plan["tx_cw_text"],
        tx_cw_wpm=plan["tx_cw_wpm"],
        backend="simulated" if simulate else "external",
        started_utc=started,
        completed_utc=None,
        metrics=None,
        last_error=None,
    )

    if simulate:
        metrics = simulated_tx_metrics(plan)
        writes = [{"status": "dry_run" if dry_run() else "simulated"}]
    else:
        backend = tx_backend_path()
        if not backend.is_file() or not os.access(str(backend), os.X_OK):
            message = f"TX backend is not installed: {backend}"
            save_tx_state(
                state="error",
                last_error={"code": "tx_backend_missing", "message": message, "time_utc": now_utc()},
            )
            raise ApiError("tx_backend_missing", message, status=503)
        if plan["tx_audio_source"] == "file" and not Path(plan["tx_audio_path"]).exists():
            message = f"TX audio path does not exist: {plan['tx_audio_path']}"
            save_tx_state(
                state="error",
                last_error={"code": "tx_audio_missing", "message": message, "time_utc": now_utc()},
            )
            raise ApiError("tx_audio_missing", message, status=404)
        writes = apply_tx_config(plan)
        env = os.environ.copy()
        env.update(
            {
                "PLUTO_TX_MODE": plan["tx_mode"],
                "PLUTO_TX_ONLY": "1",
                "PLUTO_LOOPBACK_DURATION_MS": str(plan["duration_seconds"] * 1000),
                "PLUTO_LOOPBACK_SAMPLE_RATE_HZ": str(plan["sample_rate_hz"]),
                "PLUTO_LOOPBACK_TONE_HZ": str(plan["tx_tone_hz"]),
                "PLUTO_LOOPBACK_TX_AMPLITUDE": str(plan["tx_amplitude"]),
                "PLUTO_TX_AUDIO_SOURCE": plan["tx_audio_source"],
                "PLUTO_TX_AUDIO_PATH": plan["tx_audio_path"],
                "PLUTO_TX_AUDIO_RATE_HZ": str(plan["tx_audio_rate_hz"]),
                "PLUTO_TX_AUDIO_TONE_HZ": str(plan["tx_audio_tone_hz"]),
                "PLUTO_TX_AM_INDEX": str(plan["tx_am_modulation_index"]),
                "PLUTO_TX_FM_DEVIATION_HZ": str(plan["tx_fm_deviation_hz"]),
                "PLUTO_TX_CW_TEXT": plan["tx_cw_text"],
                "PLUTO_TX_CW_WPM": str(plan["tx_cw_wpm"]),
            }
        )
        proc = subprocess.run(
            [str(backend)],
            check=False,
            capture_output=True,
            text=True,
            env=env,
            timeout=plan["duration_seconds"] + 5,
        )
        try:
            write_attr(find_iio_device(), "ensm_mode", "alert")
        except Exception:
            pass
        if proc.returncode != 0:
            message = (proc.stderr or "TX backend failed").strip()
            save_tx_state(
                state="error",
                last_error={"code": "tx_failed", "message": message, "time_utc": now_utc()},
            )
            raise ApiError("tx_failed", message, status=503, details={"returncode": proc.returncode})
        try:
            metrics = json.loads(proc.stdout or "{}")
        except json.JSONDecodeError as exc:
            raise ApiError("tx_backend_json", str(exc), status=503)

    completed = save_tx_state(
        state="complete",
        completed_utc=now_utc(),
        metrics=metrics,
        last_error=None,
    )
    return {"ok": True, "tx": completed, "writes": writes, "bounded": True}


def stop_tx():
    writes = []
    if dry_run():
        writes.append({"status": "dry_run", "attr": "ensm_mode", "value": "alert"})
    else:
        try:
            writes.append(write_attr(find_iio_device(), "ensm_mode", "alert"))
        except ApiError:
            raise
        except Exception as exc:
            raise ApiError("tx_stop_failed", str(exc), status=503)
    state = save_tx_state(state="stopped", completed_utc=now_utc(), last_error=None)
    return {"ok": True, "tx": state, "writes": writes}


