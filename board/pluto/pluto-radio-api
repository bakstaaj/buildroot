def download_capture_http(handler, params):
    capture_id = validate_capture_id(params.get("capture_id", ""))
    data_path, _meta_path = capture_paths(capture_id, params)
    if not data_path.is_file():
        raise ApiError("capture_not_found", "capture data was not found", status=404, details={"capture_id": capture_id})
    handler.send_response(200)
    handler.send_header("Content-Type", "application/octet-stream")
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("Content-Disposition", f'attachment; filename="{capture_id}.bin"')
    try:
        handler.send_header("Content-Length", str(data_path.stat().st_size))
    except OSError:
        pass
    handler.end_headers()
    with data_path.open("rb") as handle:
        shutil.copyfileobj(handle, handler.wfile)


def http_request_path_and_query(request_path):
    parsed_url = urlsplit(request_path)
    query = flatten_params(parse_qs(parsed_url.query, keep_blank_values=True))
    path = parsed_url.path or "/"
    if path and not path.startswith("/"):
        path = "/" + path
    return path, query


class RadioApiHttpServer(ThreadingHTTPServer):
    daemon_threads = True


class RadioApiHttpHandler(BaseHTTPRequestHandler):
    server_version = "PlutoRadioAPI/0.1"

    def log_message(self, fmt, *args):
        sys.stderr.write("%s - - [%s] %s\n" % (self.client_address[0], self.log_date_time_string(), fmt % args))

    def do_GET(self):
        self.handle_api()

    def do_POST(self):
        self.handle_api()

    def do_PUT(self):
        self.handle_api()

    def do_PATCH(self):
        self.handle_api()

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Allow", "GET, POST, PUT, PATCH, OPTIONS")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()

    def read_payload(self, method, query):
        payload = dict(query)
        if method not in {"POST", "PUT", "PATCH"}:
            return payload
        length = int(self.headers.get("Content-Length") or "0")
        raw = self.rfile.read(length) if length > 0 else b""
        body = parse_request_body(raw, self.headers.get("Content-Type", ""))
        payload.update(body)
        return payload

    def handle_api(self):
        method = self.command.upper()
        path, query = http_request_path_and_query(self.path)
        try:
            payload = self.read_payload(method, query)
            if method == "GET" and path in {"/radio/audio/live.pcm", "/audio/live.pcm"}:
                stream_audio_http(self, "pcm", payload)
                return
            if method == "GET" and path in {"/radio/audio/live.wav", "/audio/live.wav"}:
                stream_audio_http(self, "wav", payload)
                return
            if method == "GET" and path in {"/radio/spectrum/stream", "/spectrum/stream"}:
                spectrum_stream_http(self, payload)
                return
            if method == "GET" and path in {"/capture/download"}:
                download_capture_http(self, payload)
                return
            send_http_json(self, route(method, path, payload))
        except ApiError as exc:
            if exc.code.startswith("audio_"):
                fail_audio_state(exc.code, exc.message)
            fail_state(exc.code, exc.message)
            send_http_json(self, {"ok": False, "error": exc.code, "message": exc.message, "details": exc.details}, exc.status)
        except (BrokenPipeError, ConnectionResetError):
            return
        except Exception as exc:
            fail_state("internal_error", str(exc))
            send_http_json(self, {"ok": False, "error": "internal_error", "message": str(exc)}, 500)


def run_http_server(argv):
    host = "127.0.0.1"
    port = 8081
    args = list(argv[2:])
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--host" and index + 1 < len(args):
            host = args[index + 1]
            index += 2
            continue
        if arg == "--port" and index + 1 < len(args):
            port = int(args[index + 1])
            index += 2
            continue
        if arg.startswith("--host="):
            host = arg.split("=", 1)[1]
        elif arg.startswith("--port="):
            port = int(arg.split("=", 1)[1])
        elif arg.startswith("host="):
            host = arg.split("=", 1)[1]
        elif arg.startswith("port="):
            port = int(arg.split("=", 1)[1])
        else:
            raise ApiError("usage", "usage: pluto-radio-api serve [host=127.0.0.1] [port=8081]", status=2)
        index += 1
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    server = RadioApiHttpServer((host, port), RadioApiHttpHandler)
    try:
        server.serve_forever()
    finally:
        server.server_close()


