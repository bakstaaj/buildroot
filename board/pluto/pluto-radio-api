def rx_frequency_offset_hz():
    try:
        return int(round(float(load_calibration_state().get("rx_frequency_offset_hz", 0.0))))
    except (TypeError, ValueError):
        return 0


def calibrated_rx_frequency_hz(requested_hz):
    requested = int(requested_hz)
    offset = rx_frequency_offset_hz()
    hardware = requested + offset
    if hardware < 70_000_000 or hardware > 6_000_000_000:
        raise ApiError(
            "calibrated_frequency_out_of_range",
            "requested frequency plus rx_frequency_offset_hz is outside the supported RX tuning range",
            details={
                "requested_frequency_hz": requested,
                "rx_frequency_offset_hz": offset,
                "hardware_frequency_hz": hardware,
            },
        )
    return hardware, offset


