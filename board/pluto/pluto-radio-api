        sample_plan = {
            "profile": profile,
            "base_frequency_hz": get_profile(profile)["default_frequency_hz"],
            "start_utc": start_utc,
            "stop_utc": stop_utc,
            "retune_interval_ms": 1000,
            "doppler_table": [
                {"offset_ms": 0, "frequency_hz": get_profile(profile)["default_frequency_hz"]},
                {"offset_ms": 1000, "frequency_hz": get_profile(profile)["default_frequency_hz"] + 100},
            ],
        }
        return doppler_plan(sample_plan)
    if command == "doppler-start":
        profile = argv[2] if len(argv) > 2 else "SAT_AUDIO_NFM"
        start_ms = int(time.time() * 1000)
        sample_plan = {
            "profile": profile,
            "base_frequency_hz": get_profile(profile)["default_frequency_hz"],
            "start_utc": datetime.fromtimestamp(start_ms / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "stop_utc": datetime.fromtimestamp((start_ms + 3000) / 1000, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "retune_interval_ms": 1000,
            "doppler_table": [
                {"offset_ms": 0, "frequency_hz": get_profile(profile)["default_frequency_hz"]},
                {"offset_ms": 1000, "frequency_hz": get_profile(profile)["default_frequency_hz"] + 100},
            ],
        }
        return doppler_start(sample_plan)
    if command == "doppler-stop":
        return doppler_stop()
    if command == "doppler-tick":
        payload = {}
        if len(argv) > 2:
            payload["now_ms"] = argv[2]
        if dry_run():
            payload.update(
                {
                    "profile": "SAT_AUDIO_NFM",
                    "base_frequency_hz": get_profile("SAT_AUDIO_NFM")["default_frequency_hz"],
                    "start_utc": now_utc(),
                    "stop_utc": datetime.fromtimestamp(time.time() + 3, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
                    "doppler_table": [{"offset_ms": 0, "frequency_hz": get_profile("SAT_AUDIO_NFM")["default_frequency_hz"]}],
                }
            )
        return doppler_tick(payload)
    raise ApiError("usage", f"unknown command {command}", status=2)


def main():
    try:
        json_response(run_cli(sys.argv))
    except ApiError as exc:
        if exc.code.startswith("audio_"):
            fail_audio_state(exc.code, exc.message)
        fail_state(exc.code, exc.message)
        json_response({"ok": False, "error": exc.code, "message": exc.message, "details": exc.details}, exc.status)
        sys.exit(1 if exc.status >= 400 else exc.status)
    except Exception as exc:
        fail_state("internal_error", str(exc))
        json_response({"ok": False, "error": "internal_error", "message": str(exc)}, 500)
        sys.exit(1)


if __name__ == "__main__":
    main()
