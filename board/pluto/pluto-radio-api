def json_response(payload, status=200):
    print(json.dumps(payload, sort_keys=True))


def flatten_params(parsed):
    return {key: values[-1] for key, values in parsed.items()}


def parse_request_body(raw, content_type):
    if not raw:
        return {}
    if isinstance(raw, bytes):
        raw = raw.decode("utf-8", "replace")
    if "application/json" in content_type:
        try:
            payload = json.loads(raw or "{}")
        except json.JSONDecodeError as exc:
            raise ApiError("invalid_json", str(exc))
        if not isinstance(payload, dict):
            raise ApiError("invalid_json", "JSON request body must be an object")
        return payload
    parsed = parse_qs(raw, keep_blank_values=True)
    return flatten_params(parsed)


def read_request_body():
    length = int(os.environ.get("CONTENT_LENGTH") or "0")
    if length <= 0:
        return {}
    raw = sys.stdin.read(length)
    return parse_request_body(raw, os.environ.get("CONTENT_TYPE", ""))


def query_params():
    parsed = parse_qs(os.environ.get("QUERY_STRING", ""), keep_blank_values=True)
    return flatten_params(parsed)


def validate_uint(value, key, min_value, max_value):
    try:
        number = int(value)
    except (TypeError, ValueError):
        raise ApiError("invalid_value", f"{key} must be an integer", details={key: value})
    if number < min_value or number > max_value:
        raise ApiError(
            "out_of_range",
            f"{key} must be between {min_value} and {max_value}",
            details={key: number},
        )
    return number


def validate_decimal(value, key, min_value=-120.0, max_value=120.0):
    try:
        number = float(value)
    except (TypeError, ValueError):
        raise ApiError("invalid_value", f"{key} must be numeric", details={key: value})
    if number < min_value or number > max_value:
        raise ApiError(
            "out_of_range",
            f"{key} must be between {min_value} and {max_value}",
            details={key: number},
        )
    return number


def validate_bool(value, key):
    if isinstance(value, bool):
        return value
    if isinstance(value, (int, float)):
        return bool(value)
    if isinstance(value, str):
        lowered = value.strip().lower()
        if lowered in {"1", "true", "yes", "on"}:
            return True
        if lowered in {"0", "false", "no", "off"}:
            return False
    raise ApiError("invalid_value", f"{key} must be boolean", details={key: value})


def validate_profile_name(name):
    if not isinstance(name, str) or not PROFILE_RE.match(name):
        raise ApiError("invalid_profile", "profile name is invalid", details={"profile": name})
    return name


def validate_capture_id(capture_id):
    if not isinstance(capture_id, str) or not CAPTURE_ID_RE.match(capture_id):
        raise ApiError("invalid_capture_id", "capture id is invalid", details={"capture_id": capture_id})
    return capture_id


def validate_tx_audio_path(value):
    if not isinstance(value, str) or not value:
        raise ApiError("invalid_value", "audio_path is required for file audio source", details={"audio_path": value})
    path = Path(value)
    if not path.is_absolute() or ".." in path.parts or not any(str(path).startswith(root) for root in TX_AUDIO_SAFE_ROOTS):
        raise ApiError(
            "invalid_audio_path",
            "audio_path must be under /mnt/jffs2, /media, /tmp, or /var/run",
            details={"audio_path": value},
        )
    return str(path)


def validate_cw_text(value):
    if value is None or value == "":
        return "CQ PLUTO"
    if not isinstance(value, str):
        raise ApiError("invalid_value", "cw_text must be text", details={"cw_text": value})
    text = value[:80]
    if not re.match(r"^[A-Za-z0-9 .,?/+-]+$", text):
        raise ApiError("invalid_value", "cw_text contains unsupported characters", details={"cw_text": value})
    return text


def validate_ft8_text(value):
    if not isinstance(value, str):
        raise ApiError("invalid_value", "tx_ft8_text must be text", details={"tx_ft8_text": value})
    text = value.strip().upper()
    if not text or len(text) > 35 or any(ord(ch) < 32 or ord(ch) > 126 for ch in text):
        raise ApiError("invalid_value", "tx_ft8_text must contain 1 to 35 printable ASCII characters")
    return text


def validate_optional_decimal(payload, key, default, min_value, max_value):
    if key not in payload:
        return default
    return validate_decimal(payload.get(key), key, min_value, max_value)


def validate_notes(value):
    if value is None:
        return ""
    if not isinstance(value, str):
        raise ApiError("invalid_value", "notes must be text", details={"notes": value})
    return value[:200]


def clean_profile(profile, source):
    name = validate_profile_name(profile.get("name", ""))
    cleaned = {key: profile[key] for key in profile if key in DEMOSAFE_FIELDS}
    cleaned["name"] = name
    if "source_frequency_hz" in cleaned:
        cleaned["source_frequency_hz"] = validate_uint(
            cleaned.get("source_frequency_hz"), "source_frequency_hz", 0, 6_000_000_000
        )
    if "frequency_translation_hz" in cleaned:
        cleaned["frequency_translation_hz"] = validate_decimal(
            cleaned.get("frequency_translation_hz"), "frequency_translation_hz", -6_000_000_000, 6_000_000_000
        )
        if float(cleaned["frequency_translation_hz"]).is_integer():
            cleaned["frequency_translation_hz"] = int(cleaned["frequency_translation_hz"])
    if "translated_frequency_hz" in cleaned:
        cleaned["translated_frequency_hz"] = validate_uint(
            cleaned.get("translated_frequency_hz"), "translated_frequency_hz", 70_000_000, 6_000_000_000
        )
    if all(key in cleaned for key in ("source_frequency_hz", "frequency_translation_hz", "translated_frequency_hz")):
        expected = int(cleaned["source_frequency_hz"] + cleaned["frequency_translation_hz"])
        if cleaned["translated_frequency_hz"] != expected:
            raise ApiError(
                "invalid_profile",
                "translated_frequency_hz must equal source_frequency_hz + frequency_translation_hz",
                details={"profile": name, "expected_translated_frequency_hz": expected},
            )
    cleaned["default_frequency_hz"] = validate_uint(
        cleaned.get("default_frequency_hz"), "default_frequency_hz", 70_000_000, 6_000_000_000
    )
    cleaned["sample_rate_hz"] = validate_uint(
        cleaned.get("sample_rate_hz"), "sample_rate_hz", MIN_AD9361_SAMPLE_RATE_HZ, MAX_AD9361_SAMPLE_RATE_HZ
    )
    cleaned["rf_bandwidth_hz"] = validate_uint(
        cleaned.get("rf_bandwidth_hz"), "rf_bandwidth_hz", 200_000, 56_000_000
    )
    cleaned["fir_enabled"] = validate_bool(cleaned.get("fir_enabled", False), "fir_enabled")
    mode = cleaned.get("gain_control_mode", "manual")
    if mode not in GAIN_MODES:
        raise ApiError("invalid_profile", "profile gain_control_mode is invalid", details={"profile": name})
    cleaned["gain_control_mode"] = mode
    cleaned["gain_db"] = validate_decimal(cleaned.get("gain_db", 40), "gain_db")
    demod = cleaned.get("demod_mode")
    if demod and demod not in AUDIO_DEMODES and demod != "iq":
        raise ApiError("invalid_profile", "profile demod_mode is invalid", details={"profile": name, "demod_mode": demod})
    cleaned["audio_rate_hz"] = validate_uint(cleaned.get("audio_rate_hz", 0), "audio_rate_hz", 0, 48000)
    cleaned["filter_width_hz"] = validate_uint(
        cleaned.get("filter_width_hz", 0), "filter_width_hz", 0, cleaned["sample_rate_hz"]
    )
    if "rx_if_offset_hz" in cleaned:
        cleaned["rx_if_offset_hz"] = validate_uint(cleaned.get("rx_if_offset_hz"), "rx_if_offset_hz", 0, 1_000_000)
    if "cw_bfo_hz" in cleaned:
        cleaned["cw_bfo_hz"] = validate_uint(cleaned.get("cw_bfo_hz"), "cw_bfo_hz", 100, 3000)
    cleaned["squelch_db"] = validate_decimal(cleaned.get("squelch_db", -120), "squelch_db", -120.0, 0.0)
    deemphasis = cleaned.get("deemphasis", "none")
    if deemphasis not in DEEMPHASIS_MODES:
        raise ApiError("invalid_profile", "profile deemphasis is invalid", details={"profile": name, "deemphasis": deemphasis})
    cleaned["deemphasis"] = deemphasis
    agc = cleaned.get("agc", "manual")
    if agc not in AUDIO_AGC_MODES:
        raise ApiError("invalid_profile", "profile agc is invalid", details={"profile": name, "agc": agc})
    cleaned["agc"] = agc
    cleaned["output_gain"] = validate_decimal(cleaned.get("output_gain", 1.0), "output_gain", 0.0, 16.0)
    cleaned["noise_gate_db"] = validate_decimal(cleaned.get("noise_gate_db", -120), "noise_gate_db", -120.0, 0.0)
    cleaned["dc_block"] = validate_bool(cleaned.get("dc_block", True), "dc_block")
    cleaned["tx_allowed"] = bool(cleaned.get("tx_allowed", False))
    tx_mode = cleaned.get("tx_mode", "tone")
    if tx_mode not in TX_MODES:
        raise ApiError("invalid_profile", "profile tx_mode is invalid", details={"profile": name, "tx_mode": tx_mode})
    cleaned["tx_mode"] = tx_mode
    audio_source = cleaned.get("tx_audio_source", "tone")
    if audio_source not in TX_AUDIO_SOURCES:
        raise ApiError("invalid_profile", "profile audio_source is invalid", details={"profile": name})
    cleaned["tx_audio_source"] = audio_source
    if "tx_audio_path" in cleaned and cleaned["tx_audio_path"]:
        cleaned["tx_audio_path"] = validate_tx_audio_path(cleaned["tx_audio_path"])
    cleaned["tx_audio_rate_hz"] = validate_uint(cleaned.get("tx_audio_rate_hz", 8000), "tx_audio_rate_hz", 8000, 48000)
    cleaned["tx_audio_tone_hz"] = validate_uint(cleaned.get("tx_audio_tone_hz", 1000), "tx_audio_tone_hz", 20, 3000)
    cleaned["tx_am_modulation_index"] = validate_decimal(
        cleaned.get("tx_am_modulation_index", 0.8), "tx_am_modulation_index", 0.0, 1.0
    )
    cleaned["tx_fm_deviation_hz"] = validate_uint(
        cleaned.get("tx_fm_deviation_hz", 5000), "tx_fm_deviation_hz", 100, 25000
    )
    cleaned["tx_cw_text"] = validate_cw_text(cleaned.get("tx_cw_text", "CQ PLUTO"))
    cleaned["tx_cw_wpm"] = validate_uint(cleaned.get("tx_cw_wpm", 12), "tx_cw_wpm", 5, 40)
    cleaned["tx_ft8_text"] = validate_ft8_text(cleaned.get("tx_ft8_text", "CQ K1ABC FN42"))
    cleaned["tx_duration_limit_seconds"] = validate_uint(
        cleaned.get("tx_duration_limit_seconds", 0),
        "tx_duration_limit_seconds",
        0,
        TX_MAX_SECONDS,
    )
    cleaned["loopback_duration_limit_seconds"] = validate_uint(
        cleaned.get("loopback_duration_limit_seconds", 0),
        "loopback_duration_limit_seconds",
        0,
        LOOPBACK_MAX_SECONDS,
    )
    cleaned["tx_gain_db"] = validate_decimal(cleaned.get("tx_gain_db", -30.0), "tx_gain_db", -89.75, 0.0)
    cleaned["tx_tone_hz"] = validate_uint(cleaned.get("tx_tone_hz", 10000), "tx_tone_hz", 0, 200000)
    if cleaned["tx_mode"] == "tone" and cleaned["tx_tone_hz"] < 100:
        raise ApiError("invalid_profile", "tone TX profiles require tx_tone_hz >= 100", details={"profile": name})
    if cleaned["tx_mode"] in {"am", "fm"} and cleaned["tx_audio_source"] == "file" and not cleaned.get("tx_audio_path"):
        raise ApiError("invalid_profile", "file audio profiles require audio_path", details={"profile": name})
    cleaned["tx_amplitude"] = validate_decimal(
        cleaned.get("tx_amplitude", 0.05), "tx_amplitude", 0.0, TX_MAX_TX_AMPLITUDE
    )
    cleaned["source"] = str(source)
    return cleaned


def load_profiles():
    profiles = {}
    for directory in reversed(profile_dirs()):
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.json")):
            try:
                with path.open("r", encoding="utf-8") as handle:
                    profile = clean_profile(json.load(handle), path)
            except json.JSONDecodeError as exc:
                raise ApiError("invalid_profile_json", f"{path}: {exc}", status=500)
            if path.stem != profile["name"]:
                raise ApiError(
                    "invalid_profile",
                    "profile filename must match profile name",
                    status=500,
                    details={"file": str(path), "name": profile["name"]},
                )
            profiles[profile["name"]] = profile
    return profiles


def get_profile(name):
    name = validate_profile_name(name)
    profiles = load_profiles()
    if name not in profiles:
        raise ApiError("unknown_profile", "profile does not exist", details={"profile": name}, status=404)
    return profiles[name]


def active_profile_from_state():
    state = load_state()
    name = state.get("active_profile")
    if not name:
        raise ApiError("no_active_profile", "apply a radio profile before starting audio", status=409)
    return get_profile(name)


def find_iio_device(name=RADIO_NAME):
    root = Path("/sys/bus/iio/devices")
    if not root.is_dir():
        return None
    for candidate in root.glob("iio:device*"):
        name_file = candidate / "name"
        try:
            if name_file.read_text(encoding="utf-8").strip() == name:
                return candidate
        except OSError:
            continue
    return None


def ensure_rx_iq_scan_enabled():
    rx_device = find_iio_device("cf-ad9361-lpc")
    if not rx_device:
        return []
    writes = []
    desired = {
        "in_voltage0_en": "1",
        "in_voltage1_en": "1",
        "in_voltage2_en": "0",
        "in_voltage3_en": "0",
    }
    for attr, value in desired.items():
        path = rx_device / "scan_elements" / attr
        if not path.exists():
            continue
        try:
            path.write_text(value, encoding="utf-8")
            writes.append({"attr": f"cf-ad9361-lpc/scan_elements/{attr}", "status": "ok", "value": value})
        except OSError as exc:
            writes.append({"attr": f"cf-ad9361-lpc/scan_elements/{attr}", "status": "error", "error": str(exc), "value": value})
    return writes


def read_attr(device, attr):
    if not device:
        return None
    path = device / attr
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return None


def parse_iio_available_range(raw):
    if not raw:
        return None
    cleaned = raw.replace("[", " ").replace("]", " ").replace(",", " ")
    values = []
    for token in cleaned.split():
        try:
            values.append(int(float(token)))
        except ValueError:
            continue
    if len(values) < 3:
        return None
    return {"min": values[0], "step": max(values[1], 1), "max": values[2], "raw": raw}


def sample_rate_available(device, direction):
    attr = f"{direction}_voltage_sampling_frequency_available"
    parsed = parse_iio_available_range(read_attr(device, attr))
    if parsed:
        return parsed
    return {
        "min": MIN_AD9361_SAMPLE_RATE_HZ,
        "step": 1,
        "max": MAX_AD9361_SAMPLE_RATE_HZ,
        "raw": None,
    }


def validate_device_sample_rate(device, direction, rate):
    available = sample_rate_available(device, direction)
    if rate < available["min"] or rate > available["max"] or ((rate - available["min"]) % available["step"]) != 0:
        raise ApiError(
            "invalid_sample_rate",
            f"{direction.upper()} sample_rate_hz is not supported by the current AD9361 clock path",
            status=400,
            details={
                "sample_rate_hz": rate,
                "available": available,
                "direction": direction,
            },
        )
    return rate


def apply_profile_fir_mode(device, profile):
    if "fir_enabled" not in profile:
        return []
    enabled = "1" if profile.get("fir_enabled") else "0"
    writes = []
    if enabled == "1":
        sample_rate = int(profile.get("sample_rate_hz") or 0)
        rf_bandwidth = int(profile.get("rf_bandwidth_hz") or 0)
        if sample_rate == 520999 and rf_bandwidth == 521000:
            writes.append(write_attr(device, "filter_fir_config", AD9361_FIR_521K_CONFIG, required=True))
    if dry_run():
        writes.append(write_attr(device, "in_out_voltage_filter_fir_en", enabled, required=False))
        return writes
    current = read_attr(device, "in_out_voltage_filter_fir_en")
    if current == enabled:
        writes.append({"attr": "in_out_voltage_filter_fir_en", "value": enabled, "status": "unchanged"})
        return writes
    result = write_attr(device, "in_out_voltage_filter_fir_en", enabled, required=False)
    writes.append(result)
    if result.get("status") in {"error", "missing"}:
        writes.append(write_attr(device, "in_voltage_filter_fir_en", enabled, required=False))
    if read_attr(device, "in_out_voltage_filter_fir_en") != enabled and read_attr(device, "in_voltage_filter_fir_en") != enabled:
        raise ApiError(
            "radio_write_failed",
            "failed changing FIR enable state",
            status=503,
            details={"target": enabled, "writes": writes},
        )
    return writes


def write_attr(device, attr, value, required=False):
    if dry_run():
        return {"attr": attr, "value": str(value), "status": "dry_run"}
    if not device:
        raise ApiError("radio_not_found", f"{RADIO_NAME} was not found", status=503)
    path = device / attr
    if not path.exists():
        if required:
            raise ApiError("missing_radio_attr", f"missing required radio attribute {attr}", status=503)
        return {"attr": attr, "value": str(value), "status": "missing"}
    try:
        path.write_text(str(value), encoding="utf-8")
    except OSError as exc:
        if required:
            raise ApiError("radio_write_failed", f"failed writing {attr}: {exc}", status=503)
        return {"attr": attr, "value": str(value), "status": "error", "error": str(exc)}
    return {"attr": attr, "value": str(value), "status": "ok"}


def current_radio_attrs():
    device = find_iio_device()
    attrs = {
        "phy_path": str(device) if device else "",
        "radio_present": bool(device),
        "rx_lo_hz": read_attr(device, "out_altvoltage0_RX_LO_frequency"),
        "tx_lo_hz": read_attr(device, "out_altvoltage1_TX_LO_frequency"),
        "rx_sample_rate_hz": read_attr(device, "in_voltage_sampling_frequency"),
        "rx_sample_rate_available": read_attr(device, "in_voltage_sampling_frequency_available"),
        "rx_rf_bandwidth_hz": read_attr(device, "in_voltage_rf_bandwidth"),
        "rx_fir_enabled": read_attr(device, "in_voltage_filter_fir_en"),
        "trx_fir_enabled": read_attr(device, "in_out_voltage_filter_fir_en"),
        "rx_path_rates": read_attr(device, "rx_path_rates"),
        "rx_gain_control_mode_ch0": read_attr(device, "in_voltage0_gain_control_mode"),
        "rx_gain_control_mode_ch1": read_attr(device, "in_voltage1_gain_control_mode"),
        "rx_hardwaregain_db_ch0": read_attr(device, "in_voltage0_hardwaregain"),
        "rx_hardwaregain_db_ch1": read_attr(device, "in_voltage1_hardwaregain"),
        "ensm_mode": read_attr(device, "ensm_mode"),
        "temperature_raw": read_attr(device, "temp0_input"),
    }
    return attrs


def apply_profile(payload):
    profile = get_profile(payload.get("profile", ""))
    frequency = validate_uint(
        payload.get("frequency_hz", profile["default_frequency_hz"]),
        "frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    gain_db = validate_decimal(payload.get("gain_db", profile["gain_db"]), "gain_db")
    gain_mode = payload.get("gain_control_mode", profile["gain_control_mode"])
    if gain_mode not in GAIN_MODES:
        raise ApiError("invalid_value", "gain_control_mode is invalid", details={"gain_control_mode": gain_mode})

    device = find_iio_device()
    writes = apply_profile_fir_mode(device, profile)
    sample_rate_hz = validate_device_sample_rate(device, "in", profile["sample_rate_hz"])
    hardware_frequency, rx_offset = calibrated_rx_frequency_hz(frequency)
    writes.extend([
        write_attr(device, "out_altvoltage0_RX_LO_frequency", hardware_frequency, required=True),
        write_attr(device, "in_voltage_rf_bandwidth", profile["rf_bandwidth_hz"], required=True),
        write_attr(device, "in_voltage_sampling_frequency", sample_rate_hz, required=True),
        write_attr(device, "in_voltage0_gain_control_mode", gain_mode, required=True),
        write_attr(device, "in_voltage1_gain_control_mode", gain_mode),
    ])
    if gain_mode == "manual":
        writes.extend(
            [
                write_attr(device, "in_voltage0_hardwaregain", gain_db, required=True),
                write_attr(device, "in_voltage1_hardwaregain", gain_db),
            ]
        )

    state = save_state(
        active_profile=profile["name"],
        requested_frequency_hz=frequency,
        hardware_frequency_hz=read_attr(device, "out_altvoltage0_RX_LO_frequency") or hardware_frequency,
        actual_frequency_hz=read_attr(device, "out_altvoltage0_RX_LO_frequency") or hardware_frequency,
        rx_frequency_offset_hz=rx_offset,
        gain_control_mode=gain_mode,
        gain_db=gain_db,
        stream_state="idle",
        radio_state="tuned",
        profile_settings={
            "sample_rate_hz": profile["sample_rate_hz"],
            "rf_bandwidth_hz": profile["rf_bandwidth_hz"],
            "fir_enabled": profile.get("fir_enabled", False),
            "demod_mode": profile.get("demod_mode"),
            "audio_rate_hz": profile.get("audio_rate_hz"),
            "filter_width_hz": profile.get("filter_width_hz"),
            "frequency_shift_hz": profile.get("frequency_shift_hz", 0),
            "squelch_db": profile.get("squelch_db"),
            "deemphasis": profile.get("deemphasis"),
            "agc": profile.get("agc"),
            "output_gain": profile.get("output_gain"),
            "noise_gate_db": profile.get("noise_gate_db"),
            "dc_block": profile.get("dc_block"),
            "stream_format": profile.get("stream_format"),
        },
        last_error=None,
    )
    return {"ok": True, "profile": profile["name"], "state": state, "writes": writes}


def tune(payload):
    frequency = validate_uint(payload.get("frequency_hz"), "frequency_hz", 70_000_000, 6_000_000_000)
    device = find_iio_device()
    hardware_frequency, rx_offset = calibrated_rx_frequency_hz(frequency)
    writes = [write_attr(device, "out_altvoltage0_RX_LO_frequency", hardware_frequency, required=True)]
    state = save_state(
        requested_frequency_hz=frequency,
        hardware_frequency_hz=read_attr(device, "out_altvoltage0_RX_LO_frequency") or hardware_frequency,
        actual_frequency_hz=read_attr(device, "out_altvoltage0_RX_LO_frequency") or hardware_frequency,
        rx_frequency_offset_hz=rx_offset,
        radio_state="tuned",
        last_error=None,
    )
    return {"ok": True, "state": state, "writes": writes}


def stop_radio():
    stop_audio()
    try:
        stop_tx()
    except ApiError:
        if not dry_run():
            raise
    state = save_state(stream_state="idle", radio_state="idle", last_error=None)
    return {"ok": True, "state": state}


def list_profiles():
    return {"ok": True, "profiles": list(load_profiles().values())}


def radio_status():
    state = load_state()
    attrs = current_radio_attrs()
    return {
        "ok": True,
        "radio": {
            "active_profile": state.get("active_profile"),
            "requested_frequency_hz": state.get("requested_frequency_hz"),
            "actual_frequency_hz": attrs.get("rx_lo_hz") or state.get("actual_frequency_hz"),
            "hardware_frequency_hz": attrs.get("rx_lo_hz") or state.get("hardware_frequency_hz") or state.get("actual_frequency_hz"),
            "rx_frequency_offset_hz": rx_frequency_offset_hz(),
            "gain_control_mode": attrs.get("rx_gain_control_mode_ch0") or state.get("gain_control_mode"),
            "gain_db": attrs.get("rx_hardwaregain_db_ch0") or state.get("gain_db"),
            "stream_state": state.get("stream_state", "idle"),
            "audio": audio_status()["audio"],
            "radio_state": state.get("radio_state", "idle"),
            "last_error": state.get("last_error"),
            "tx_policy": "disabled_by_default_no_enable_api",
            "tx_allowed": False,
        },
        "iio": attrs,
    }


def process_alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    if os.name == "nt":
        return dry_run()
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def selected_audio_profile(payload, apply_tuning=True):
    profile_name = payload.get("profile")
    if profile_name:
        profile = get_profile(profile_name)
        if apply_tuning and audio_tuning_requested(payload):
            apply_profile(payload)
        return profile
    return active_profile_from_state()


def audio_capable_profile(profile):
    demod = profile.get("demod_mode")
    audio_rate = int(profile.get("audio_rate_hz") or 0)
    if demod not in AUDIO_DEMODES or audio_rate <= 0:
        raise ApiError(
            "audio_not_supported",
            "profile does not define a firmware audio mode",
            status=409,
            details={"profile": profile.get("name"), "demod_mode": demod, "audio_rate_hz": audio_rate},
        )
    return demod, audio_rate


def audio_controls(profile, payload):
    sample_rate_hz = int(profile.get("sample_rate_hz") or 0)
    controls = {
        "filter_width_hz": validate_uint(
            payload.get("filter_width_hz", profile.get("filter_width_hz", 0)),
            "filter_width_hz",
            0,
            sample_rate_hz,
        ),
        "frequency_shift_hz": int(
            validate_decimal(
                payload.get("frequency_shift_hz", profile.get("frequency_shift_hz", 0)),
                "frequency_shift_hz",
                -float(sample_rate_hz) / 2.0,
                float(sample_rate_hz) / 2.0,
            )
        ),
        "cw_bfo_hz": validate_uint(
            payload.get("cw_bfo_hz", profile.get("cw_bfo_hz", 700)),
            "cw_bfo_hz",
            100,
            3000,
        ),
        "squelch_db": validate_decimal(
            payload.get("squelch_db", profile.get("squelch_db", -120)),
            "squelch_db",
            -120.0,
            0.0,
        ),
        "output_gain": validate_decimal(
            payload.get("output_gain", profile.get("output_gain", 1.0)),
            "output_gain",
            0.0,
            16.0,
        ),
        "noise_gate_db": validate_decimal(
            payload.get("noise_gate_db", profile.get("noise_gate_db", -120)),
            "noise_gate_db",
            -120.0,
            0.0,
        ),
        "dc_block": validate_bool(payload.get("dc_block", profile.get("dc_block", True)), "dc_block"),
    }
    iq_mode = payload.get("iq_mode", profile.get("iq_mode", "normal"))
    if iq_mode not in IQ_MODES:
        raise ApiError("invalid_value", "iq_mode is invalid", details={"iq_mode": iq_mode, "allowed": sorted(IQ_MODES)})
    controls["iq_mode"] = "invert_q" if iq_mode == "conjugate" else iq_mode
    deemphasis = payload.get("deemphasis", profile.get("deemphasis", "none"))
    if deemphasis not in DEEMPHASIS_MODES:
        raise ApiError("invalid_value", "deemphasis is invalid", details={"deemphasis": deemphasis})
    controls["deemphasis"] = deemphasis
    agc = payload.get("agc", profile.get("agc", "manual"))
    if agc not in AUDIO_AGC_MODES:
        raise ApiError("invalid_value", "agc is invalid", details={"agc": agc})
    controls["agc"] = agc
    return controls


def audio_backend_path(payload):
    if str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}:
        return SIM_AUDIO_BACKEND, "simulated_pcm"
    override = os.environ.get("PLUTO_AUDIO_BACKEND")
    if override:
        return Path(override), "external"
    return DEFAULT_AUDIO_BACKEND, "external"

def audio_tuning_requested(payload):
    return any(key in payload for key in ("frequency_hz", "gain_db", "gain_control_mode"))


def audio_retune_payload(profile, payload):
    retune = {"profile": profile["name"]}
    for key in ("frequency_hz", "gain_db", "gain_control_mode"):
        if key in payload:
            retune[key] = payload[key]
    return retune


def force_rx_streaming_mode(device=None):
    device = device or find_iio_device()
    return write_attr(device, "ensm_mode", "fdd")


def audio_retune(payload):
    existing = audio_status()["audio"]
    profile_name = payload.get("profile") or existing.get("profile") or load_state().get("active_profile")
    profile = get_profile(profile_name or "")
    if existing.get("state") == "running" and existing.get("profile") and existing.get("profile") != profile["name"]:
        raise ApiError(
            "audio_retune_profile_mismatch",
            "audio retune cannot change profile; call /radio/audio/start to restart the audio pipeline",
            status=409,
            details={"running_profile": existing.get("profile"), "requested_profile": profile["name"]},
        )
    frequency = validate_uint(
        payload.get("frequency_hz", load_state().get("requested_frequency_hz") or profile["default_frequency_hz"]),
        "frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    gain_mode = payload.get("gain_control_mode", load_state().get("gain_control_mode") or profile["gain_control_mode"])
    if gain_mode not in GAIN_MODES:
        raise ApiError("invalid_value", "gain_control_mode is invalid", details={"gain_control_mode": gain_mode})
    gain_db = validate_decimal(payload.get("gain_db", load_state().get("gain_db") or profile["gain_db"]), "gain_db")

    device = find_iio_device()
    hardware_frequency, rx_offset = calibrated_rx_frequency_hz(frequency)
    writes = [write_attr(device, "out_altvoltage0_RX_LO_frequency", hardware_frequency, required=True)]
    if "gain_control_mode" in payload:
        writes.extend(
            [
                write_attr(device, "in_voltage0_gain_control_mode", gain_mode, required=True),
                write_attr(device, "in_voltage1_gain_control_mode", gain_mode),
            ]
        )
    if gain_mode == "manual" and ("gain_db" in payload or "gain_control_mode" in payload):
        writes.extend(
            [
                write_attr(device, "in_voltage0_hardwaregain", gain_db, required=True),
                write_attr(device, "in_voltage1_hardwaregain", gain_db),
            ]
        )
    writes.append(force_rx_streaming_mode(device))
    state = save_state(
        active_profile=profile["name"],
        requested_frequency_hz=frequency,
        hardware_frequency_hz=read_attr(device, "out_altvoltage0_RX_LO_frequency") or hardware_frequency,
        actual_frequency_hz=read_attr(device, "out_altvoltage0_RX_LO_frequency") or hardware_frequency,
        rx_frequency_offset_hz=rx_offset,
        gain_control_mode=gain_mode,
        gain_db=gain_db,
        stream_state="audio" if existing.get("state") == "running" else load_state().get("stream_state", "idle"),
        radio_state="tuned",
        last_error=None,
    )
    return {"ok": True, "profile": profile["name"], "state": state, "audio": audio_status()["audio"], "writes": writes}


def audio_rf_health_error(state):
    if state.get("backend") != "external":
        return None
    phase = state.get("phase")
    try:
        refills = int(state.get("iio_refills") or 0)
    except (TypeError, ValueError):
        refills = 0
    if phase not in {"iio_streaming", "iio_refill_wait"} or refills <= 0:
        return None
    ensm_mode = read_attr(find_iio_device(), "ensm_mode")
    if ensm_mode and ensm_mode not in {"fdd", "rx"}:
        return {
            "code": "rx_chain_not_streaming",
            "message": f"audio backend is running but AD9361 ensm_mode is {ensm_mode}, not fdd/rx",
            "time_utc": now_utc(),
            "ensm_mode": ensm_mode,
            "phase": phase,
            "iio_refills": refills,
        }
    return None


def audio_request_matches(existing, profile, demod, audio_rate, controls, backend_kind):
    if existing.get("profile") != profile["name"]:
        return False
    if existing.get("demod_mode") != demod:
        return False
    if int(existing.get("audio_rate_hz") or 0) != int(audio_rate):
        return False
    if existing.get("backend") != backend_kind:
        return False
    existing_controls = existing.get("controls") or {}
    for key, value in controls.items():
        if existing_controls.get(key) != value:
            return False
    return True


def load_audio_backend_report(pid):
    try:
        report = read_json_file(AUDIO_BACKEND_STATUS_FILE, {})
    except ApiError:
        return None
    report_pid = report.get("pid")
    try:
        if report_pid is not None and pid is not None and int(report_pid) != int(pid):
            return None
    except (TypeError, ValueError):
        return None
    return report or None


def merge_audio_backend_report(state, report):
    if not report:
        return state
    for key in (
        "backend_path",
        "iio_refills",
        "input_sample_rate_hz",
        "frequency_shift_hz",
        "fm_channel_filter",
        "fm_limiter",
        "cw_decode",
        "ft8_decode",
        "iq_mode",
        "iq_decimation",
        "last_error",
        "pcm_bytes",
        "pcm_measured_rate_hz",
        "pcm_rate_hz",
        "phase",
        "processing_sample_rate_hz",
        "rms_level",
        "squelch_state",
        "updated_utc",
    ):
        if key in report:
            state[key] = report[key]
    return state


def clear_audio_backend_status():
    try:
        AUDIO_BACKEND_STATUS_FILE.unlink()
    except FileNotFoundError:
        pass
    except OSError:
        pass


def audio_status():
    state = load_audio_state()
    status = state.get("state", "stopped")
    pid = state.get("pid")
    backend_report = load_audio_backend_report(pid) if status == "running" else None
    if backend_report and backend_report.get("state") == "error" and backend_report.get("last_error"):
        status = "error"
        state.update(backend_report)
        state["state"] = status
        if not dry_run():
            save_audio_state(**state)
            save_state(stream_state="error")
    elif status == "running" and not process_alive(pid):
        status = "error"
        state["state"] = status
        state["last_error"] = {
            "code": "audio_process_exited",
            "message": "audio backend process is no longer running",
            "time_utc": now_utc(),
        }
        if not dry_run():
            save_audio_state(**state)
            save_state(stream_state="error")
    elif status == "running" and backend_report:
        state = merge_audio_backend_report(state, backend_report)
        rf_error = audio_rf_health_error(state)
        if rf_error:
            status = "error"
            state["state"] = status
            state["last_error"] = rf_error
            if not dry_run():
                save_state(stream_state="error")
        if not dry_run():
            save_audio_state(**state)
    return {
        "ok": True,
        "audio": {
            "state": status,
            "profile": state.get("profile"),
            "demod_mode": state.get("demod_mode"),
            "audio_rate_hz": state.get("audio_rate_hz"),
            "stream_format": state.get("stream_format", "pcm_s16le"),
            "fifo_path": state.get("fifo_path", str(AUDIO_FIFO)),
            "pid": pid,
            "backend": state.get("backend"),
            "restart_count": state.get("restart_count", 0),
            "rms_level": state.get("rms_level"),
            "squelch_state": state.get("squelch_state", "unknown"),
            "iio_refills": state.get("iio_refills"),
            "input_sample_rate_hz": state.get("input_sample_rate_hz"),
            "frequency_shift_hz": state.get("frequency_shift_hz"),
            "fm_channel_filter": state.get("fm_channel_filter"),
            "fm_limiter": state.get("fm_limiter"),
            "cw_decode": state.get("cw_decode"),
            "ft8_decode": state.get("ft8_decode"),
            "iq_mode": state.get("iq_mode"),
            "processing_sample_rate_hz": state.get("processing_sample_rate_hz"),
