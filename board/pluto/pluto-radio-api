    value = payload.get("confirm_live_tx")
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.lower() in {"1", "true", "yes", "on", "i_understand_this_transmits_rf"}
    return False


def validate_loopback(payload):
    profile = get_profile(payload.get("profile", "LOOPBACK_TEST"))
    if not profile.get("tx_allowed"):
        raise ApiError(
            "tx_not_allowed",
            "profile is not enabled for TX loopback",
            status=403,
            details={"profile": profile["name"]},
        )
    profile_limit = int(profile.get("loopback_duration_limit_seconds") or LOOPBACK_MAX_SECONDS)
    duration_max = max(1, min(profile_limit, LOOPBACK_MAX_SECONDS))
    duration_seconds = validate_uint(payload.get("duration_seconds", duration_max), "duration_seconds", 1, duration_max)
    frequency_hz = validate_uint(
        payload.get("frequency_hz", profile["default_frequency_hz"]),
        "frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    tx_gain_db = validate_decimal(payload.get("tx_gain_db", profile.get("tx_gain_db", -30.0)), "tx_gain_db", -89.75, 0.0)
    tx_tone_hz = validate_uint(payload.get("tx_tone_hz", profile.get("tx_tone_hz", 10000)), "tx_tone_hz", 100, 200000)
    tx_amplitude = validate_decimal(
        payload.get("tx_amplitude", profile.get("tx_amplitude", 0.05)),
        "tx_amplitude",
        0.0,
        LOOPBACK_MAX_TX_AMPLITUDE,
    )
    sample_rate_hz = validate_uint(
        payload.get("sample_rate_hz", profile["sample_rate_hz"]),
        "sample_rate_hz",
        MIN_AD9361_SAMPLE_RATE_HZ,
        MAX_AD9361_SAMPLE_RATE_HZ,
    )
    if tx_tone_hz >= sample_rate_hz // 4:
        raise ApiError(
            "invalid_loopback_tone",
            "tx_tone_hz must be below one quarter of sample_rate_hz",
            details={"tx_tone_hz": tx_tone_hz, "sample_rate_hz": sample_rate_hz},
        )
    return {
        "profile": profile,
        "frequency_hz": frequency_hz,
        "duration_seconds": duration_seconds,
        "tx_gain_db": tx_gain_db,
        "tx_tone_hz": tx_tone_hz,
        "tx_amplitude": tx_amplitude,
        "sample_rate_hz": sample_rate_hz,
        "rf_bandwidth_hz": profile["rf_bandwidth_hz"],
        "gain_db": profile["gain_db"],
    }


def apply_loopback_config(plan):
    profile = plan["profile"]
    apply_profile(
        {
            "profile": profile["name"],
            "frequency_hz": plan["frequency_hz"],
            "gain_db": plan["gain_db"],
            "gain_control_mode": profile["gain_control_mode"],
        }
    )
    device = find_iio_device()
    sample_rate_hz = validate_device_sample_rate(device, "out", plan["sample_rate_hz"])
    writes = [
        write_attr(device, "out_altvoltage1_TX_LO_frequency", plan["frequency_hz"], required=True),
        write_attr(device, "out_voltage_rf_bandwidth", plan["rf_bandwidth_hz"], required=True),
        write_attr(device, "out_voltage_sampling_frequency", sample_rate_hz, required=True),
        write_attr(device, "out_voltage0_hardwaregain", plan["tx_gain_db"], required=True),
        write_attr(device, "out_voltage1_hardwaregain", plan["tx_gain_db"]),
        write_attr(device, "ensm_mode", "fdd"),
    ]
    return writes


def simulated_loopback_metrics(plan):
    noise = -82.0
    tone = -38.0 + (float(plan["tx_amplitude"]) * 20.0)
    return {
        "ok": True,
        "samples": int(plan["duration_seconds"] * plan["sample_rate_hz"]),
        "duration_ms": int(plan["duration_seconds"] * 1000),
        "sample_rate_hz": plan["sample_rate_hz"],
        "tone_hz": plan["tx_tone_hz"],
        "tx_amplitude": plan["tx_amplitude"],
        "rx_rms_dbfs": round(tone, 2),
        "rx_peak_dbfs": round(tone + 8.0, 2),
        "noise_floor_dbfs": noise,
        "simulated": True,
    }


def start_loopback(payload):
    plan = validate_loopback(payload)
    simulate = dry_run() or str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}
    if not simulate and not tx_confirmation(payload):
        raise ApiError(
            "tx_confirmation_required",
            "set confirm_live_tx=true to run a bounded live RF loopback test",
            status=403,
        )

    started = now_utc()
    save_loopback_state(
        state="running",
        profile=plan["profile"]["name"],
        frequency_hz=plan["frequency_hz"],
        duration_seconds=plan["duration_seconds"],
        tx_gain_db=plan["tx_gain_db"],
        tx_tone_hz=plan["tx_tone_hz"],
        tx_amplitude=plan["tx_amplitude"],
        backend="simulated" if simulate else "external",
        started_utc=started,
        completed_utc=None,
        metrics=None,
        last_error=None,
    )

    if simulate:
        metrics = simulated_loopback_metrics(plan)
        writes = [{"status": "dry_run" if dry_run() else "simulated"}]
    else:
        if not LOOPBACK_BACKEND.is_file() or not os.access(str(LOOPBACK_BACKEND), os.X_OK):
            message = f"loopback backend is not installed: {LOOPBACK_BACKEND}"
            save_loopback_state(
                state="error",
                last_error={"code": "loopback_backend_missing", "message": message, "time_utc": now_utc()},
            )
            raise ApiError("loopback_backend_missing", message, status=503)
        writes = apply_loopback_config(plan)
        env = os.environ.copy()
        env.update(
            {
                "PLUTO_LOOPBACK_DURATION_MS": str(plan["duration_seconds"] * 1000),
                "PLUTO_LOOPBACK_SAMPLE_RATE_HZ": str(plan["sample_rate_hz"]),
                "PLUTO_LOOPBACK_TONE_HZ": str(plan["tx_tone_hz"]),
                "PLUTO_LOOPBACK_TX_AMPLITUDE": str(plan["tx_amplitude"]),
            }
        )
        proc = subprocess.run(
            [str(LOOPBACK_BACKEND)],
            check=False,
            capture_output=True,
            text=True,
            env=env,
            timeout=plan["duration_seconds"] + 5,
        )
        try:
            write_attr(find_iio_device(), "ensm_mode", "alert")
        except Exception:
            pass
        if proc.returncode != 0:
            message = (proc.stderr or "loopback backend failed").strip()
            save_loopback_state(
                state="error",
                last_error={"code": "loopback_failed", "message": message, "time_utc": now_utc()},
            )
            raise ApiError("loopback_failed", message, status=503, details={"returncode": proc.returncode})
        try:
            metrics = json.loads(proc.stdout or "{}")
        except json.JSONDecodeError as exc:
            raise ApiError("loopback_backend_json", str(exc), status=503)

    completed = save_loopback_state(
        state="complete",
        completed_utc=now_utc(),
        metrics=metrics,
        last_error=None,
    )
    return {"ok": True, "loopback": completed, "writes": writes, "bounded": True}


