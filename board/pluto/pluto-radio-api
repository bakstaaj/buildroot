def tx_readiness(payload=None):
    payload = payload or {}
    blockers = []
    warnings = []
    plan = None
    try:
        plan = validate_tx(payload) if payload else None
    except ApiError as exc:
        blockers.append({"code": exc.code, "message": exc.message, "details": exc.details})

    attrs = current_radio_attrs()
    radio_present = attrs.get("radio_present", False)
    backend = tx_backend_path()
    backend_available = backend.is_file() and os.access(str(backend), os.X_OK)
    simulate = dry_run() or str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}
    confirmation = tx_confirmation(payload) if payload else False

    if not radio_present:
        warnings.append({"code": "radio_not_detected", "message": "AD936x IIO device is not visible"})
    if not backend_available:
        warnings.append({"code": "tx_backend_missing", "message": str(backend)})
    if payload and not simulate and not confirmation:
        blockers.append(
            {
                "code": "tx_confirmation_required",
                "message": "set confirm_live_tx=true to run bounded live RF TX",
            }
        )

    return {
        "profile": plan["profile"]["name"] if plan else payload.get("profile"),
        "simulation_ready": plan is not None,
        "live_ready": plan is not None and radio_present and backend_available and confirmation,
        "radio_present": radio_present,
        "tx_backend": str(backend),
        "tx_backend_available": backend_available,
        "confirmation_required": bool(payload and not simulate),
        "confirmed": confirmation,
        "simulate": simulate,
        "blockers": blockers,
        "warnings": warnings,
    }


def tx_guardrails(payload=None):
