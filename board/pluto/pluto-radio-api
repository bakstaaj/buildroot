def simulated_spectrum(center_hz, span_hz, bins, top_n, sequence=0):
    start_hz = center_hz - span_hz // 2
    step_hz = span_hz / max(1, bins - 1)
    drift = (sequence % 24) - 12
    carriers = (
        (center_hz - span_hz * 0.18 + drift * step_hz * 0.20, -49.0),
        (center_hz + span_hz * 0.07 - drift * step_hz * 0.15, -42.0),
        (center_hz + span_hz * 0.31 + drift * step_hz * 0.10, -56.0),
    )
    points = []
    for idx in range(bins):
        freq = int(start_hz + idx * step_hz)
        baseline = -92.0 + ((idx * 17) % 11) * 0.45
        power = baseline
        for carrier_freq, carrier_power in carriers:
            distance_bins = abs(freq - carrier_freq) / max(1.0, step_hz)
            if distance_bins < 3:
                power = max(power, carrier_power - distance_bins * 5.5)
        points.append({"frequency_hz": freq, "power_dbfs": round(power, 2)})
    noise_floor = round(sum(point["power_dbfs"] for point in points) / len(points), 2)
    peaks = sorted(points, key=lambda point: point["power_dbfs"], reverse=True)[:top_n]
    for peak in peaks:
        peak["snr_db"] = round(peak["power_dbfs"] - noise_floor, 2)
    return points, peaks, noise_floor


def doppler_center_from_plan(plan, now_ms):
    if not plan:
        return None
    table = plan.get("doppler_table", [])
    if not table:
        return None
    start_ms = int(plan.get("start_epoch_ms") or 0)
    elapsed_ms = int(now_ms) - start_ms
    before = None
    after = None
    for point in table:
        offset_ms = int(point.get("offset_ms") or 0)
        frequency_hz = int(point.get("frequency_hz") or 0)
        if frequency_hz <= 0:
            continue
        if offset_ms <= elapsed_ms:
            before = (offset_ms, frequency_hz)
        if offset_ms >= elapsed_ms:
            after = (offset_ms, frequency_hz)
            break
    if before and after:
        if after[0] == before[0]:
            return before[1]
        ratio = (elapsed_ms - before[0]) / max(1, after[0] - before[0])
        return int(round(before[1] + ((after[1] - before[1]) * ratio)))
    if before:
        return before[1]
    if after:
        return after[1]
    return None


def write_spectrum_doppler_file(plan):
    table = plan.get("doppler_table", []) if plan else []
    if not table:
        return None
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=str(STATE_DIR), prefix="spectrum-doppler-", suffix=".csv", delete=False)
    try:
        for point in table:
            handle.write(f"{int(point.get('offset_ms') or 0)} {int(point.get('frequency_hz') or 0)}\n")
        return Path(handle.name)
    finally:
        handle.close()


def spectrum_request(payload):
    profile = spectrum_profile(payload)
    current_state = load_state()
    center_hz = validate_uint(
        payload.get("center_frequency_hz") or payload.get("frequency_hz") or current_state.get("requested_frequency_hz") or profile["default_frequency_hz"],
        "center_frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    span_hz = validate_uint(payload.get("span_hz", profile.get("rf_bandwidth_hz", 200_000)), "span_hz", 1_000, 56_000_000)
    bins = validate_uint(payload.get("bins", 256), "bins", 16, SPECTRUM_MAX_BINS)
    top_n = validate_uint(payload.get("top_n", 5), "top_n", 1, SPECTRUM_MAX_TOP_N)
    simulate = dry_run() or str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}
    sample_rate = profile.get("sample_rate_hz", "") if simulate else read_attr(find_iio_device(), "in_voltage_sampling_frequency") or profile.get("sample_rate_hz", "")
    return profile, center_hz, span_hz, bins, top_n, sample_rate, simulate


def prepare_spectrum_radio(profile, center_hz, payload):
    apply_payload = {
        "profile": profile["name"],
        "frequency_hz": center_hz,
    }
    if "gain_db" in payload:
        apply_payload["gain_db"] = payload["gain_db"]
    if "gain_control_mode" in payload:
        apply_payload["gain_control_mode"] = payload["gain_control_mode"]
    result = apply_profile(apply_payload)
    device = find_iio_device()
    writes = list(result.get("writes", []))
    writes.append(write_attr(device, "ensm_mode", "fdd"))
    sample_rate = read_attr(device, "in_voltage_sampling_frequency") or profile.get("sample_rate_hz", "")
    return writes, sample_rate


