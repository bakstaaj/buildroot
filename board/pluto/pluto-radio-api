def web_setting_valid(key, value):
    try:
        if key in {"rx_lo_hz", "tx_lo_hz"}:
            validate_uint(value, key, 70_000_000, 6_000_000_000)
        elif key in {"rx_sample_rate_hz", "tx_sample_rate_hz"}:
            validate_uint(value, key, MIN_AD9361_SAMPLE_RATE_HZ, MAX_AD9361_SAMPLE_RATE_HZ)
        elif key in {"rx_rf_bandwidth_hz", "tx_rf_bandwidth_hz"}:
            validate_uint(value, key, 200_000, 56_000_000)
        elif key == "rx_gain_control_mode":
            if value not in GAIN_MODES:
                return False
        elif key in {"rx_hardwaregain_db", "tx_hardwaregain_db"}:
            validate_decimal(value, key)
        elif key == "ensm_mode":
            if value not in {"sleep", "alert", "fdd", "pinctrl", "rx", "tx"}:
                return False
        else:
            return False
    except ApiError:
        return False
    return True


