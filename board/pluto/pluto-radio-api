        tx_proc = subprocess.Popen([str(backend)], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=tx_env)
        capture_thread.join(timeout=capture_seconds + 5)
        if capture_result["error"] is not None:
            raise capture_result["error"]
        pcm = capture_result["pcm"]
        require_bounded_pcm_capture(pcm, target_bytes, capture_seconds)
        tx_stdout, tx_stderr = tx_proc.communicate(timeout=tx_plan["duration_seconds"] + 5)
        if tx_proc.returncode != 0:
            raise ApiError("tx_failed", (tx_stderr or "TX backend failed").strip(), status=503, details={"returncode": tx_proc.returncode})

        metrics = pcm_s16le_metrics(pcm, audio_rate, tone_hz)
