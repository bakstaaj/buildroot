def tail_lines(path, max_lines):
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            lines = handle.readlines()
    except OSError:
        return None
    return [line.rstrip("\n") for line in lines[-max_lines:]]


def dmesg_lines(max_lines):
    if os.name == "nt":
        return None
    try:
        proc = subprocess.run(["dmesg"], check=False, capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    return proc.stdout.splitlines()[-max_lines:]


def system_logs(params):
    max_lines = validate_uint(params.get("lines", 100), "lines", 1, 500)
    source = params.get("source", "messages")
    if source == "dmesg":
        lines = dmesg_lines(max_lines)
        available = lines is not None
    elif source in LOG_FILES:
        path = LOG_FILES[source]
        lines = tail_lines(path, max_lines)
        available = lines is not None
    else:
        raise ApiError("invalid_log_source", "unknown log source", details={"source": source})
    return {
        "ok": True,
        "logs": {
            "source": source,
            "available": available,
            "lines": lines or [],
            "line_count": len(lines or []),
        },
    }


def meminfo():
    values = {}
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as handle:
            for line in handle:
                parts = line.split()
                if parts:
                    values[parts[0].rstrip(":").lower() + "_kb"] = int(parts[1])
    except OSError:
        pass
    return values


def disk_usage(path):
    try:
        usage = shutil.disk_usage(path)
    except OSError:
        return None
    return {"total_bytes": usage.total, "used_bytes": usage.used, "free_bytes": usage.free}


def read_first_line(path):
    try:
        return Path(path).read_text(encoding="utf-8").splitlines()[0]
    except (OSError, IndexError):
        return ""


def df_line(path):
    usage = disk_usage(path)
    if not usage:
        return ""
    total = usage["total_bytes"] // 1024
    used = usage["used_bytes"] // 1024
    free = usage["free_bytes"] // 1024
    percent = int((used * 100) / total) if total else 0
    return f"{total},{used},{free},{percent}%"


def net_stat(iface, stat):
    return read_first_line(f"/sys/class/net/{iface}/statistics/{stat}")


def ip_addr(iface):
    try:
        proc = subprocess.run(["/sbin/ifconfig", iface], check=False, capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return ""
    match = re.search(r"inet addr:([0-9.]+)", proc.stdout)
    if match:
        return match.group(1)
    match = re.search(r"\binet ([0-9.]+)", proc.stdout)
    return match.group(1) if match else ""


def iface_mode(iface):
    try:
        lines = Path("/etc/network/interfaces").read_text(encoding="utf-8").splitlines()
    except OSError:
        return "unknown"
    for line in lines:
        parts = line.split()
        if len(parts) >= 4 and parts[0] == "iface" and parts[1] == iface:
            return parts[3]
    return "unknown"


def lease_entries(path):
    entries = []
    try:
        lines = Path(path).read_text(encoding="utf-8").splitlines()
    except OSError:
        return entries
    for line in lines:
        parts = line.split()
        if len(parts) >= 2 and re.match(r"^[0-9a-fA-F][0-9a-fA-F]:", parts[0]):
            entries.append((parts[0], parts[1]))
    return entries


