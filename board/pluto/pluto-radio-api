def spectrum_snapshot(payload):
    profile, center_hz, span_hz, bins, top_n, sample_rate, simulate = spectrum_request(payload)
    writes = []

    if simulate:
        points, peaks, noise_floor = simulated_spectrum(center_hz, span_hz, bins, top_n)
        backend = "simulated"
    else:
        if not SPECTRUM_BACKEND.is_file() or not os.access(str(SPECTRUM_BACKEND), os.X_OK):
            message = f"spectrum backend is not installed: {SPECTRUM_BACKEND}"
            save_spectrum_state(
                state="error",
                last_error={"code": "spectrum_backend_missing", "message": message, "time_utc": now_utc()},
            )
            raise ApiError("spectrum_backend_missing", message, status=503)
        writes, sample_rate = prepare_spectrum_radio(profile, center_hz, payload)
        env = os.environ.copy()
        env.update(
            {
                "PLUTO_SPECTRUM_CENTER_HZ": str(center_hz),
                "PLUTO_SPECTRUM_SPAN_HZ": str(span_hz),
                "PLUTO_SPECTRUM_BINS": str(bins),
                "PLUTO_SPECTRUM_TOP_N": str(top_n),
                "PLUTO_SPECTRUM_PROFILE": profile["name"],
                "PLUTO_SPECTRUM_SAMPLE_RATE_HZ": str(sample_rate),
            }
        )
        proc = subprocess.run([str(SPECTRUM_BACKEND)], check=False, capture_output=True, text=True, env=env, timeout=10)
        if proc.returncode != 0:
            raise ApiError("spectrum_failed", "spectrum backend failed", status=503, details={"returncode": proc.returncode})
        try:
            backend_payload = json.loads(proc.stdout)
        except json.JSONDecodeError as exc:
            raise ApiError("spectrum_backend_json", str(exc), status=503)
        points = backend_payload.get("points", [])
        peaks = backend_payload.get("peaks", [])
        noise_floor = backend_payload.get("noise_floor_dbfs")
        backend = "external"

    save_spectrum_state(
        state="idle",
        profile=profile["name"],
        center_frequency_hz=center_hz,
        span_hz=span_hz,
        bins=bins,
        backend=backend,
        last_snapshot_utc=now_utc(),
        last_error=None,
    )
    return {
        "ok": True,
        "spectrum": {
            "profile": profile["name"],
            "center_frequency_hz": center_hz,
            "span_hz": span_hz,
            "bins": bins,
            "noise_floor_dbfs": noise_floor,
            "peaks": peaks,
            "points": points,
            "backend": backend,
            "bounded": True,
            "writes": writes,
        },
    }


