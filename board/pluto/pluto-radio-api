def cw_text_units(text):
    total = 0
    pending_char_gap = False
    for char in text.upper():
        if char == " ":
            if total:
                total += 7
            pending_char_gap = False
            continue
        symbols = MORSE_UNIT_SYMBOLS.get(char)
        if not symbols:
            continue
        if pending_char_gap:
            total += 3
        total += sum(3 if symbol == "-" else 1 for symbol in symbols)
        total += max(0, len(symbols) - 1)
        pending_char_gap = True
    return total


def self_test_cw_duration_seconds(payload, wpm, text):
    if "cw_duration_seconds" in payload:
        return validate_uint(payload.get("cw_duration_seconds"), "cw_duration_seconds", 3, TX_MAX_SECONDS)
    units = cw_text_units(text)
    message_seconds = (units * 1.2) / max(1, wpm)
    return min(TX_MAX_SECONDS, max(10, int(math.ceil(message_seconds + 8))))


