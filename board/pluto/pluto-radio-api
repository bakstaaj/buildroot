    backend = tx_backend_path()
    audio_backend = DEFAULT_AUDIO_BACKEND
    if not backend.is_file() or not os.access(str(backend), os.X_OK):
        raise ApiError("tx_backend_missing", f"TX backend is not installed: {backend}", status=503)
    if not audio_backend.is_file() or not os.access(str(audio_backend), os.X_OK):
        raise ApiError("audio_backend_missing", f"audio backend is not installed: {audio_backend}", status=503)

