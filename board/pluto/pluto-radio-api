def pcm_s16le_metrics(pcm_bytes, sample_rate_hz, tone_hz):
    sample_count = len(pcm_bytes) // 2
    if sample_count <= 0:
        return {
            "sample_count": 0,
            "duration_seconds": 0.0,
            "pcm_bytes": len(pcm_bytes),
            "rms_dbfs": None,
            "peak_dbfs": None,
            "tone_hz": tone_hz,
            "detected_tone_hz": None,
            "tone_error_hz": None,
            "tone_dbfs": None,
            "tone_snr_db": None,
            "passed": False,
        }

    samples = []
    sum_sq = 0.0
    abs_peak = 0
    reference_bins = [max(20, tone_hz // 2), tone_hz * 2, min(sample_rate_hz // 2 - 1, tone_hz * 3)]
    reference = [0.0 for _ in reference_bins]
    ref_omega = [2.0 * math.pi * float(freq) / float(sample_rate_hz) for freq in reference_bins]

    for index in range(sample_count):
        offset = index * 2
        sample = int.from_bytes(pcm_bytes[offset : offset + 2], byteorder="little", signed=True)
        samples.append(float(sample))
        sum_sq += float(sample) * float(sample)
        if abs(sample) > abs_peak:
            abs_peak = abs(sample)
        for ref_index, ref in enumerate(ref_omega):
            reference[ref_index] += float(sample) * math.cos(ref * index)

    def magnitude_at(freq_hz):
        omega = 2.0 * math.pi * float(freq_hz) / float(sample_rate_hz)
        i_acc = 0.0
        q_acc = 0.0
        for index, sample in enumerate(samples):
            i_acc += sample * math.cos(omega * index)
            q_acc -= sample * math.sin(omega * index)
        return math.sqrt(i_acc * i_acc + q_acc * q_acc) * 2.0 / float(sample_count)

    search_min = max(20, int(tone_hz) - 150)
    search_max = min(sample_rate_hz // 2 - 1, int(tone_hz) + 150)
    tone_freq = int(tone_hz)
    tone_mag = 0.0
    for candidate in range(search_min, search_max + 1, 5):
        candidate_mag = magnitude_at(candidate)
        if candidate_mag > tone_mag:
            tone_mag = candidate_mag
            tone_freq = candidate

    rms = math.sqrt(sum_sq / float(sample_count))
    ref_mag = max(abs(value) for value in reference) * 2.0 / float(sample_count) if reference else 1.0
    rms_dbfs = 20.0 * math.log10(max(rms, 1.0) / 32768.0)
    peak_dbfs = 20.0 * math.log10(max(float(abs_peak), 1.0) / 32768.0)
    tone_dbfs = 20.0 * math.log10(max(tone_mag, 1.0) / 32768.0)
    reference_dbfs = 20.0 * math.log10(max(ref_mag, 1.0) / 32768.0)
    tone_snr_db = tone_dbfs - reference_dbfs

    return {
        "sample_count": sample_count,
        "duration_seconds": round(float(sample_count) / float(sample_rate_hz), 4),
        "pcm_bytes": len(pcm_bytes),
        "rms_dbfs": round(rms_dbfs, 2),
        "peak_dbfs": round(peak_dbfs, 2),
        "tone_hz": tone_hz,
        "detected_tone_hz": tone_freq,
        "tone_error_hz": tone_freq - int(tone_hz),
        "tone_dbfs": round(tone_dbfs, 2),
        "reference_dbfs": round(reference_dbfs, 2),
        "tone_snr_db": round(tone_snr_db, 2),
        "passed": tone_dbfs > -85.0 and tone_snr_db >= 12.0,
        "pass_criteria": {"tone_dbfs_min": -85.0, "tone_snr_db_min": 12.0},
    }


def cw_keying_metrics(pcm_bytes, sample_rate_hz, tone_hz, wpm):
    sample_count = len(pcm_bytes) // 2
    if sample_count <= 0:
        return {
            "keyed_percent": 0.0,
            "keying_segments": 0,
            "estimated_wpm": None,
            "decode_supported": False,
        }
    window = max(32, int(sample_rate_hz * 0.01))
    levels = []
    for offset in range(0, sample_count, window):
        end = min(sample_count, offset + window)
        if end <= offset:
            continue
        acc = 0.0
        count = 0
        for sample_index in range(offset, end):
            byte_offset = sample_index * 2
            sample = int.from_bytes(pcm_bytes[byte_offset : byte_offset + 2], byteorder="little", signed=True)
            acc += float(sample * sample)
            count += 1
        levels.append(math.sqrt(acc / max(1, count)))
    if not levels:
        return {
            "keyed_percent": 0.0,
            "keying_segments": 0,
            "estimated_wpm": None,
            "decode_supported": False,
        }
    peak = max(levels)
    threshold = max(2.0, peak * 0.35)
    keyed = [level >= threshold for level in levels]
    keyed_windows = sum(1 for value in keyed if value)
    segments = 0
    last = False
    for value in keyed:
        if value and not last:
            segments += 1
        last = value
    unit_seconds = 1.2 / max(1, int(wpm))
    estimated_wpm = 1.2 / unit_seconds
    return {
        "bfo_hz": tone_hz,
        "requested_wpm": int(wpm),
        "estimated_wpm": round(estimated_wpm, 2),
        "keyed_percent": round((keyed_windows / len(keyed)) * 100.0, 2),
        "keying_segments": segments,
        "window_ms": round((window / sample_rate_hz) * 1000.0, 3),
        "threshold_rms": round(threshold, 3),
        "peak_window_rms": round(peak, 3),
        "decode_supported": False,
        "decode_note": "This endpoint verifies recovered CW tone/keying. Morse text decode is not enabled yet.",
    }


def read_fifo_bounded(path, target_bytes, timeout_seconds):
    fd = os.open(str(path), os.O_RDONLY | os.O_NONBLOCK)
    chunks = []
    total = 0
    deadline = time.time() + float(timeout_seconds)
    try:
        while total < target_bytes and time.time() < deadline:
            ready, _, _ = select.select([fd], [], [], 0.25)
            if not ready:
                continue
            try:
                chunk = os.read(fd, min(8192, target_bytes - total))
            except BlockingIOError:
                continue
            if not chunk:
                time.sleep(0.02)
                continue
            chunks.append(chunk)
            total += len(chunk)
    finally:
        os.close(fd)
    return b"".join(chunks)


def start_fifo_capture(path, target_bytes, timeout_seconds):
    result = {"pcm": b"", "error": None}

    def worker():
        try:
            result["pcm"] = read_fifo_bounded(path, target_bytes, timeout_seconds)
        except Exception as exc:
            result["error"] = exc

    thread = threading.Thread(target=worker, daemon=True)
    thread.start()
    return thread, result


def require_bounded_pcm_capture(pcm, target_bytes, capture_seconds):
    if len(pcm) >= target_bytes:
        return
    raise ApiError(
        "loopback_capture_short",
        "loopback diagnostic did not receive the requested PCM capture length",
        status=503,
        details={
            "pcm_bytes": len(pcm),
            "target_bytes": target_bytes,
            "capture_seconds": capture_seconds,
        },
    )


def run_loopback_backend_full_duplex(
    rx_profile,
    tx_plan,
    rx_frequency_hz,
    rx_lo_frequency_hz,
    rx_if_offset_hz,
    rx_gain_db,
    rx_gain_mode,
    duration_seconds,
    mode,
    expect_tone_hz,
    state_updates,
):
    if not LOOPBACK_BACKEND.is_file() or not os.access(str(LOOPBACK_BACKEND), os.X_OK):
        raise ApiError("loopback_backend_missing", f"loopback backend is not installed: {LOOPBACK_BACKEND}", status=503)

    stop_audio()
    stop_tx()
    clear_audio_backend_status()
    writes = []
    try:
        writes.extend(
            apply_profile(
                {
                    "profile": rx_profile["name"],
                    "frequency_hz": rx_lo_frequency_hz,
                    "gain_db": rx_gain_db,
                    "gain_control_mode": rx_gain_mode,
                }
            ).get("writes", [])
        )
        writes.extend(ensure_rx_iq_scan_enabled())
        writes.extend(apply_tx_hardware_only(tx_plan))
        env = os.environ.copy()
        env.update(
            {
                "PLUTO_TX_MODE": mode,
                "PLUTO_TX_ONLY": "0",
                "PLUTO_LOOPBACK_DURATION_MS": str(int(duration_seconds) * 1000),
                "PLUTO_LOOPBACK_SAMPLE_RATE_HZ": str(tx_plan["sample_rate_hz"]),
                "PLUTO_LOOPBACK_TONE_HZ": str(tx_plan["tx_tone_hz"]),
                "PLUTO_LOOPBACK_EXPECT_TONE_HZ": str(expect_tone_hz),
                "PLUTO_LOOPBACK_RX_IF_OFFSET_HZ": str(rx_if_offset_hz),
                "PLUTO_LOOPBACK_TX_AMPLITUDE": str(tx_plan["tx_amplitude"]),
                "PLUTO_TX_AUDIO_SOURCE": tx_plan["tx_audio_source"],
                "PLUTO_TX_AUDIO_PATH": tx_plan["tx_audio_path"],
                "PLUTO_TX_AUDIO_RATE_HZ": str(tx_plan["tx_audio_rate_hz"]),
                "PLUTO_TX_AUDIO_TONE_HZ": str(tx_plan["tx_audio_tone_hz"]),
                "PLUTO_TX_AM_INDEX": str(tx_plan["tx_am_modulation_index"]),
                "PLUTO_TX_FM_DEVIATION_HZ": str(tx_plan["tx_fm_deviation_hz"]),
                "PLUTO_TX_CW_TEXT": tx_plan["tx_cw_text"],
                "PLUTO_TX_CW_WPM": str(tx_plan["tx_cw_wpm"]),
            }
        )
        proc = subprocess.run(
            [str(LOOPBACK_BACKEND)],
            check=False,
            capture_output=True,
            text=True,
            env=env,
            timeout=int(duration_seconds) + 8,
        )
        if proc.returncode != 0:
            raise ApiError(
                "loopback_backend_failed",
                (proc.stderr or "loopback backend failed").strip(),
                status=503,
                details={"returncode": proc.returncode},
            )
        try:
            metrics = json.loads(proc.stdout or "{}")
        except json.JSONDecodeError as exc:
            raise ApiError("loopback_backend_json", str(exc), status=503, details={"stdout": proc.stdout})
        metrics["rx_frequency_hz"] = rx_frequency_hz
        metrics["rx_lo_frequency_hz"] = rx_lo_frequency_hz
        metrics["rx_if_offset_hz"] = rx_if_offset_hz
        metrics["backend"] = "pluto-loopback-backend"
        completed_updates = dict(state_updates)
        for key in ("state", "metrics", "last_error", "completed_utc", "updated_utc"):
            completed_updates.pop(key, None)
        state = save_loopback_demod_state(
            **completed_updates,
            state="complete",
            completed_utc=now_utc(),
            metrics=metrics,
            last_error=None,
        )
        return state, writes
    finally:
        clear_audio_backend_status()
        save_audio_state(**stopped_audio_updates())
        try:
            write_attr(find_iio_device(), "ensm_mode", "alert")
        except Exception:
            pass


def start_loopback_demod(payload):
    rx_profile = get_profile(payload.get("rx_profile", "NOAA_NFM"))
    demod, audio_rate = audio_capable_profile(rx_profile)
    if demod not in {"nfm", "wfm", "am"}:
        raise ApiError(
            "invalid_rx_profile",
            "loopback demod diagnostic requires an FM or AM receive profile",
            details={"rx_profile": rx_profile["name"], "demod_mode": demod},
        )

    default_tx_profile = "TX_AUDIO_AM" if demod == "am" else "TX_AUDIO_FM"
    default_tx_mode = "am" if demod == "am" else "fm"
    default_tx_amplitude = 0.05 if demod == "am" else 0.20
    tx_payload = dict(payload)
    tx_payload["profile"] = payload.get("tx_profile", default_tx_profile)
    tx_payload.setdefault("tx_mode", default_tx_mode)
    tx_payload.setdefault("tx_audio_source", "tone")
    tx_payload.setdefault("tx_audio_tone_hz", 1000)
    tx_payload.setdefault("tx_fm_deviation_hz", 5000)
    tx_payload.setdefault("tx_am_modulation_index", 0.8)
    tx_payload.setdefault("duration_seconds", 5)
    tx_payload.setdefault("tx_gain_db", -35)
    tx_payload.setdefault("tx_amplitude", default_tx_amplitude)

    rx_frequency_default = rx_profile.get("translated_frequency_hz", rx_profile.get("default_frequency_hz"))
    if rx_frequency_default is not None and "frequency_hz" not in tx_payload and "tx_frequency_hz" not in tx_payload:
        tx_payload["frequency_hz"] = rx_frequency_default

    tx_plan = validate_tx(tx_payload)
    if tx_plan["tx_mode"] != default_tx_mode or tx_plan["tx_audio_source"] != "tone":
        raise ApiError(
            "invalid_tx_profile",
            f"loopback {demod} demod diagnostic requires {default_tx_mode.upper()} tone TX",
            details={"tx_profile": tx_plan["profile"]["name"], "tx_mode": tx_plan["tx_mode"]},
        )

    if not tx_confirmation(payload):
        raise ApiError("tx_confirmation_required", "set confirm_live_tx=true to run bounded live RF loopback demod", status=403)

    rx_frequency_hz = validate_uint(
        payload.get("rx_frequency_hz", payload.get("frequency_hz", rx_frequency_default if rx_frequency_default is not None else tx_plan["frequency_hz"])),
        "rx_frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    tx_plan["frequency_hz"] = validate_uint(
        payload.get("tx_frequency_hz", payload.get("frequency_hz", rx_frequency_hz)),
        "tx_frequency_hz",
        70_000_000,
        6_000_000_000,
    )
    rx_gain_db = validate_decimal(payload.get("rx_gain_db", payload.get("gain_db", rx_profile.get("gain_db", 35))), "rx_gain_db")
    rx_gain_mode = payload.get("rx_gain_control_mode", payload.get("gain_control_mode", rx_profile.get("gain_control_mode", "manual")))
    if rx_gain_mode not in GAIN_MODES:
        raise ApiError("invalid_value", "rx_gain_control_mode is invalid", details={"rx_gain_control_mode": rx_gain_mode})
    default_rx_if_offset_hz = rx_profile.get("rx_if_offset_hz", rx_profile.get("frequency_shift_hz", 25_000))
    rx_if_offset_hz = validate_uint(payload.get("rx_if_offset_hz", default_rx_if_offset_hz), "rx_if_offset_hz", 0, 1_000_000)
    rx_lo_frequency_hz = rx_frequency_hz - rx_if_offset_hz
    if rx_lo_frequency_hz < 70_000_000:
        raise ApiError(
            "invalid_rx_if_offset",
            "rx_frequency_hz - rx_if_offset_hz is below the AD9361 tuning range",
            details={"rx_frequency_hz": rx_frequency_hz, "rx_if_offset_hz": rx_if_offset_hz},
        )
    capture_seconds = validate_uint(payload.get("capture_seconds", min(4, tx_plan["duration_seconds"])), "capture_seconds", 1, tx_plan["duration_seconds"])
    tone_hz = int(tx_plan["tx_audio_tone_hz"])

    simulate = dry_run() or str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}
    if simulate:
        metrics = {
            "sample_count": capture_seconds * audio_rate,
            "duration_seconds": capture_seconds,
            "pcm_bytes": capture_seconds * audio_rate * 2,
            "rms_dbfs": -24.0,
            "peak_dbfs": -12.0,
            "tone_hz": tone_hz,
            "tone_dbfs": -18.0,
            "reference_dbfs": -55.0,
            "tone_snr_db": 37.0,
            "passed": True,
            "simulated": True,
        }
        state = save_loopback_demod_state(
            state="complete",
            mode=default_tx_mode,
            rx_profile=rx_profile["name"],
            tx_profile=tx_plan["profile"]["name"],
            rx_frequency_hz=rx_frequency_hz,
            rx_lo_frequency_hz=rx_lo_frequency_hz,
            rx_if_offset_hz=rx_if_offset_hz,
            tx_frequency_hz=tx_plan["frequency_hz"],
            duration_seconds=tx_plan["duration_seconds"],
            capture_seconds=capture_seconds,
            tx_gain_db=tx_plan["tx_gain_db"],
            tx_amplitude=tx_plan["tx_amplitude"],
            tx_audio_tone_hz=tone_hz,
            tx_fm_deviation_hz=tx_plan["tx_fm_deviation_hz"],
            tx_am_modulation_index=tx_plan["tx_am_modulation_index"],
            tx_cw_text=None,
            tx_cw_wpm=None,
            metrics=metrics,
            started_utc=now_utc(),
            completed_utc=now_utc(),
            last_error=None,
        )
        return {"ok": True, "loopback_demod": state, "bounded": True}

    started_utc = now_utc()
    running_state = save_loopback_demod_state(
        state="running",
        mode=default_tx_mode,
        rx_profile=rx_profile["name"],
        tx_profile=tx_plan["profile"]["name"],
        rx_frequency_hz=rx_frequency_hz,
        rx_lo_frequency_hz=rx_lo_frequency_hz,
        rx_if_offset_hz=rx_if_offset_hz,
        tx_frequency_hz=tx_plan["frequency_hz"],
        duration_seconds=tx_plan["duration_seconds"],
        capture_seconds=capture_seconds,
        tx_gain_db=tx_plan["tx_gain_db"],
        tx_amplitude=tx_plan["tx_amplitude"],
        tx_audio_tone_hz=tone_hz,
        tx_fm_deviation_hz=tx_plan["tx_fm_deviation_hz"],
        tx_am_modulation_index=tx_plan["tx_am_modulation_index"],
        tx_cw_text=None,
        tx_cw_wpm=None,
        started_utc=started_utc,
        completed_utc=None,
        metrics=None,
        last_error=None,
    )
    try:
        state, writes = run_loopback_backend_full_duplex(
            rx_profile,
            tx_plan,
            rx_frequency_hz,
            rx_lo_frequency_hz,
            rx_if_offset_hz,
            rx_gain_db,
            rx_gain_mode,
            capture_seconds,
            default_tx_mode,
            tone_hz,
            running_state,
        )
        return {"ok": True, "loopback_demod": state, "writes": writes, "bounded": True}
    except ApiError as exc:
        save_loopback_demod_state(
            state="error",
            completed_utc=now_utc(),
            last_error={"code": exc.code, "message": exc.message, "time_utc": now_utc(), "details": exc.details},
        )
