def spectrum_stream_to_writer(payload, write_line, before_stream=None):
    profile, center_hz, span_hz, bins, top_n, sample_rate, simulate = spectrum_request(payload)
    continuous = validate_bool(payload.get("continuous", False), "continuous")
    frames = 0 if continuous else validate_uint(payload.get("frames", 120), "frames", 1, SPECTRUM_MAX_STREAM_FRAMES)
    interval_ms = validate_uint(payload.get("interval_ms", 250), "interval_ms", 50, 60000)
    follow_doppler = validate_bool(payload.get("follow_doppler", False), "follow_doppler")
    doppler_plan_for_stream = None
    doppler_table_file = None
    if follow_doppler:
        doppler_state = load_doppler_state()
        doppler_plan_for_stream = doppler_state.get("plan")
        if not doppler_plan_for_stream:
            raise ApiError("no_doppler_plan", "load a Doppler plan before starting a Doppler-following spectrum stream", status=409)
        center_hz = doppler_center_from_plan(doppler_plan_for_stream, int(time.time() * 1000)) or center_hz

    if not simulate and (not SPECTRUM_BACKEND.is_file() or not os.access(str(SPECTRUM_BACKEND), os.X_OK)):
        message = f"spectrum backend is not installed: {SPECTRUM_BACKEND}"
        save_spectrum_state(
            state="error",
            last_error={"code": "spectrum_backend_missing", "message": message, "time_utc": now_utc()},
        )
        raise ApiError("spectrum_backend_missing", message, status=503)

    if not simulate:
        _writes, sample_rate = prepare_spectrum_radio(profile, center_hz, payload)

    if before_stream:
        before_stream()

    save_spectrum_state(
        state="streaming",
        profile=profile["name"],
        center_frequency_hz=center_hz,
        span_hz=span_hz,
        bins=bins,
        continuous=continuous,
        follow_doppler=follow_doppler,
        backend="simulated_stream" if simulate else "external_stream",
        last_error=None,
    )

    try:
        if simulate:
            sequence = 0
            while continuous or sequence < frames:
                frame_center_hz = center_hz
                if follow_doppler and doppler_plan_for_stream:
                    frame_center_hz = doppler_center_from_plan(doppler_plan_for_stream, int(time.time() * 1000)) or center_hz
                frame_started = time.time()
                points, peaks, noise_floor = simulated_spectrum(frame_center_hz, span_hz, bins, top_n, sequence)
                write_line(
                    json.dumps(
                        {
                            "ok": True,
                            "type": "spectrum_row",
                            "sequence": sequence,
                            "time_epoch": int(time.time()),
                            "sample_count": 0,
                            "sample_rate_hz": int(sample_rate or 0),
                            "center_frequency_hz": frame_center_hz,
                            "span_hz": span_hz,
                            "bins": bins,
                            "backend": "simulated_stream",
                            "bounded": False,
                            "continuous": continuous,
                            "follow_doppler": follow_doppler,
                            "frame_duration_ms": int((time.time() - frame_started) * 1000),
                            "points": points,
                            "peaks": peaks,
                            "noise_floor_dbfs": noise_floor,
                        },
                        sort_keys=True,
                    )
                )
                sequence += 1
                if continuous or sequence < frames:
                    time.sleep(interval_ms / 1000.0)
        else:
            if follow_doppler and doppler_plan_for_stream:
                doppler_table_file = write_spectrum_doppler_file(doppler_plan_for_stream)
            env = os.environ.copy()
            env.update(
                {
                    "PLUTO_SPECTRUM_CENTER_HZ": str(center_hz),
                    "PLUTO_SPECTRUM_SPAN_HZ": str(span_hz),
                    "PLUTO_SPECTRUM_BINS": str(bins),
                    "PLUTO_SPECTRUM_TOP_N": str(top_n),
                    "PLUTO_SPECTRUM_PROFILE": profile["name"],
                    "PLUTO_SPECTRUM_SAMPLE_RATE_HZ": str(sample_rate),
                    "PLUTO_SPECTRUM_STREAM": "1",
                    "PLUTO_SPECTRUM_FRAMES": str(frames),
                    "PLUTO_SPECTRUM_INTERVAL_MS": str(interval_ms),
                    "PLUTO_SPECTRUM_TUNE_RX": "1" if follow_doppler else "0",
                }
            )
            if follow_doppler and doppler_plan_for_stream and doppler_table_file:
                env.update(
                    {
                        "PLUTO_SPECTRUM_DOPPLER_FILE": str(doppler_table_file),
                        "PLUTO_SPECTRUM_DOPPLER_START_EPOCH_MS": str(doppler_plan_for_stream.get("start_epoch_ms", "")),
                    }
                )
            proc = subprocess.Popen([str(SPECTRUM_BACKEND)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, bufsize=1)
            assert proc.stdout is not None
            client_gone = False
            try:
                for line in proc.stdout:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        write_line(line)
                    except (BrokenPipeError, ConnectionResetError, OSError):
                        client_gone = True
                        break
            finally:
                if client_gone and proc.poll() is None:
                    proc.terminate()
                    try:
                        proc.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        proc.kill()
            stderr = proc.stderr.read() if proc.stderr is not None else ""
            rc = proc.wait()
            if rc != 0 and not client_gone:
                raise ApiError("spectrum_stream_failed", "spectrum backend stream failed", status=503, details={"returncode": rc, "stderr": stderr[-300:]})
    finally:
        save_spectrum_state(
            state="idle",
            profile=profile["name"],
            center_frequency_hz=center_hz,
            span_hz=span_hz,
            bins=bins,
            continuous=continuous,
            follow_doppler=follow_doppler,
            backend="simulated_stream" if simulate else "external_stream",
            last_snapshot_utc=now_utc(),
        )
        if doppler_table_file:
            try:
                doppler_table_file.unlink()
            except OSError:
                pass


def spectrum_stream(payload):
    def write_line(line):
        print(line)
        sys.stdout.flush()

    spectrum_stream_to_writer(payload, write_line)


def spectrum_stream_collect(payload):
    rows = []

    def write_line(line):
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError as exc:
            raise ApiError("spectrum_stream_invalid_json", "spectrum backend emitted invalid JSON", details={"line": line[:200]}) from exc

    spectrum_stream_to_writer(payload, write_line)
    frame_durations = [
        row.get("frame_duration_ms")
        for row in rows
        if isinstance(row, dict) and row.get("frame_duration_ms") is not None
    ]
    return {
        "ok": len(rows) > 0 and all(isinstance(row, dict) and row.get("ok", False) for row in rows),
        "spectrum_stream": {
            "rows": len(rows),
            "first_sequence": rows[0].get("sequence") if rows else None,
            "last_sequence": rows[-1].get("sequence") if rows else None,
            "center_frequency_hz": rows[-1].get("center_frequency_hz") if rows else None,
