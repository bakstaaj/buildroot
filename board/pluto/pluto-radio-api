def process_alive(pid):
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    if os.name == "nt":
        return dry_run()
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def selected_audio_profile(payload):
    profile_name = payload.get("profile")
    if profile_name:
        profile = get_profile(profile_name)
        if "frequency_hz" in payload or "gain_db" in payload:
            apply_profile(payload)
        return profile
    return active_profile_from_state()


def audio_capable_profile(profile):
    demod = profile.get("demod_mode")
    audio_rate = int(profile.get("audio_rate_hz") or 0)
    if demod not in AUDIO_DEMODES or audio_rate <= 0:
        raise ApiError(
            "audio_not_supported",
            "profile does not define a firmware audio mode",
            status=409,
            details={"profile": profile.get("name"), "demod_mode": demod, "audio_rate_hz": audio_rate},
        )
    return demod, audio_rate


def audio_controls(profile, payload):
    controls = {
        "filter_width_hz": validate_uint(
            payload.get("filter_width_hz", profile.get("filter_width_hz", 0)),
            "filter_width_hz",
            0,
            profile["sample_rate_hz"],
        ),
        "cw_bfo_hz": validate_uint(
            payload.get("cw_bfo_hz", profile.get("cw_bfo_hz", 700)),
            "cw_bfo_hz",
            100,
            3000,
        ),
        "squelch_db": validate_decimal(
            payload.get("squelch_db", profile.get("squelch_db", -120)),
            "squelch_db",
            -120.0,
            0.0,
        ),
        "output_gain": validate_decimal(
            payload.get("output_gain", profile.get("output_gain", 1.0)),
            "output_gain",
            0.0,
            16.0,
        ),
        "noise_gate_db": validate_decimal(
            payload.get("noise_gate_db", profile.get("noise_gate_db", -120)),
            "noise_gate_db",
            -120.0,
            0.0,
        ),
        "dc_block": validate_bool(payload.get("dc_block", profile.get("dc_block", True)), "dc_block"),
    }
    deemphasis = payload.get("deemphasis", profile.get("deemphasis", "none"))
    if deemphasis not in DEEMPHASIS_MODES:
        raise ApiError("invalid_value", "deemphasis is invalid", details={"deemphasis": deemphasis})
    controls["deemphasis"] = deemphasis
    agc = payload.get("agc", profile.get("agc", "manual"))
    if agc not in AUDIO_AGC_MODES:
        raise ApiError("invalid_value", "agc is invalid", details={"agc": agc})
    controls["agc"] = agc
    return controls


def audio_backend_path(payload):
    if str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}:
        return SIM_AUDIO_BACKEND, "simulated_pcm"
    override = os.environ.get("PLUTO_AUDIO_BACKEND")
    if override:
        return Path(override), "external"
    return DEFAULT_AUDIO_BACKEND, "external"


def audio_status():
    state = load_audio_state()
    status = state.get("state", "stopped")
    pid = state.get("pid")
    if status == "running" and not process_alive(pid):
        status = "error"
        state["state"] = status
        state["last_error"] = {
            "code": "audio_process_exited",
            "message": "audio backend process is no longer running",
            "time_utc": now_utc(),
        }
        if not dry_run():
            save_audio_state(**state)
            save_state(stream_state="error")
    return {
        "ok": True,
        "audio": {
            "state": status,
            "profile": state.get("profile"),
            "demod_mode": state.get("demod_mode"),
            "audio_rate_hz": state.get("audio_rate_hz"),
            "stream_format": state.get("stream_format", "pcm_s16le"),
            "fifo_path": state.get("fifo_path", str(AUDIO_FIFO)),
            "pid": pid,
            "backend": state.get("backend"),
            "restart_count": state.get("restart_count", 0),
            "rms_level": state.get("rms_level"),
            "squelch_state": state.get("squelch_state", "unknown"),
            "controls": state.get("controls", {}),
            "started_utc": state.get("started_utc"),
            "stopped_utc": state.get("stopped_utc"),
            "last_error": state.get("last_error"),
        },
    }


def start_audio(payload):
    existing = audio_status()["audio"]
    if existing["state"] == "running":
        return {"ok": True, "audio": existing}

    profile = selected_audio_profile(payload)
    demod, audio_rate = audio_capable_profile(profile)
    controls = audio_controls(profile, payload)
    backend, backend_kind = audio_backend_path(payload)
    if dry_run():
        state = {
            "state": "running",
            "profile": profile["name"],
            "demod_mode": demod,
            "audio_rate_hz": audio_rate,
            "stream_format": profile.get("stream_format", "pcm_s16le"),
            "fifo_path": str(AUDIO_FIFO),
            "pid": 0,
            "backend": "dry_run",
            "rms_level": None,
            "squelch_state": "unknown",
            "controls": controls,
            "started_utc": now_utc(),
            "stopped_utc": None,
            "last_error": None,
        }
        return {"ok": True, "audio": state}

    if not backend.is_file() or not os.access(str(backend), os.X_OK):
        message = f"audio backend is not installed: {backend}"
        fail_audio_state("audio_backend_missing", message)
        save_state(stream_state="error")
        raise ApiError("audio_backend_missing", message, status=503, details={"backend": str(backend)})

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    if AUDIO_FIFO.exists() and not AUDIO_FIFO.is_fifo():
        AUDIO_FIFO.unlink()
    if not AUDIO_FIFO.exists():
        os.mkfifo(str(AUDIO_FIFO), 0o600)

    env = os.environ.copy()
    env.update(
        {
            "PLUTO_AUDIO_FIFO": str(AUDIO_FIFO),
            "PLUTO_AUDIO_PROFILE": profile["name"],
            "PLUTO_AUDIO_DEMOD": demod,
            "PLUTO_AUDIO_RATE_HZ": str(audio_rate),
            "PLUTO_DSP_INPUT_RATE_HZ": str(profile.get("sample_rate_hz", "")),
            "PLUTO_AUDIO_FILTER_WIDTH_HZ": str(controls["filter_width_hz"]),
            "PLUTO_AUDIO_CW_BFO_HZ": str(controls["cw_bfo_hz"]),
            "PLUTO_AUDIO_SQUELCH_DB": str(controls["squelch_db"]),
            "PLUTO_AUDIO_DEEMPHASIS": controls["deemphasis"],
            "PLUTO_AUDIO_AGC": controls["agc"],
            "PLUTO_AUDIO_OUTPUT_GAIN": str(controls["output_gain"]),
            "PLUTO_AUDIO_NOISE_GATE_DB": str(controls["noise_gate_db"]),
            "PLUTO_AUDIO_DC_BLOCK": "1" if controls["dc_block"] else "0",
        }
    )
    log_path = STATE_DIR / "audio-backend.log"
    log = log_path.open("ab")
    proc = subprocess.Popen([str(backend)], stdin=subprocess.DEVNULL, stdout=log, stderr=log, env=env)
    state = save_audio_state(
        state="running",
        profile=profile["name"],
        demod_mode=demod,
        audio_rate_hz=audio_rate,
        stream_format=profile.get("stream_format", "pcm_s16le"),
        fifo_path=str(AUDIO_FIFO),
        pid=proc.pid,
        backend=backend_kind,
        backend_path=str(backend),
        rms_level=None,
        squelch_state="unknown",
        controls=controls,
        restart_count=load_audio_state().get("restart_count", 0),
        started_utc=now_utc(),
        stopped_utc=None,
        last_error=None,
    )
    save_state(stream_state="audio")
    return {"ok": True, "audio": state}


def stop_audio():
    state = load_audio_state()
    pid = state.get("pid")
    if process_alive(pid) and os.name != "nt":
        try:
            os.kill(int(pid), signal.SIGTERM)
        except OSError:
            pass
        deadline = time.time() + 2
        while time.time() < deadline and process_alive(pid):
            time.sleep(0.1)
        if process_alive(pid):
            try:
                os.kill(int(pid), signal.SIGKILL)
            except OSError:
                pass
    stopped = save_audio_state(
        state="stopped",
        stopped_utc=now_utc(),
        pid=None,
        last_error=None,
    )
    save_state(stream_state="idle")
    return {"ok": True, "audio": audio_status()["audio"], "state": stopped}


def restart_timestamps(state):
    raw = state.get("audio_restart_utc", [])
    cutoff = time.time() - WATCHDOG_WINDOW_SECONDS
    fresh = []
    for item in raw:
        try:
            parsed = time.mktime(time.strptime(item, "%Y-%m-%dT%H:%M:%SZ"))
        except (TypeError, ValueError):
            continue
        if parsed >= cutoff:
            fresh.append(item)
    return fresh


def watchdog_status():
    audio = audio_status()["audio"]
    state = load_watchdog_state()
    return {
        "ok": True,
        "watchdog": {
            "audio_state": audio["state"],
            "audio_pid": audio["pid"],
            "audio_process_alive": process_alive(audio["pid"]),
            "audio_restart_count": load_audio_state().get("restart_count", 0),
            "restart_window_seconds": WATCHDOG_WINDOW_SECONDS,
            "max_restarts_per_window": WATCHDOG_MAX_RESTARTS,
            "degraded": audio["state"] == "degraded",
            "last_action": state.get("last_action"),
            "last_reason": state.get("last_reason"),
            "last_check_utc": state.get("last_check_utc"),
        },
    }


def watchdog_check(payload=None):
    payload = payload or {}
    audio_state = load_audio_state()
    status = audio_status()["audio"]
    action = "none"
    reason = "audio_state_" + status["state"]

    if status["state"] == "error" and audio_state.get("profile"):
        wstate = load_watchdog_state()
        fresh = restart_timestamps(wstate)
        if len(fresh) >= WATCHDOG_MAX_RESTARTS:
            save_audio_state(state="degraded")
            save_state(stream_state="degraded")
            action = "degraded"
            reason = "audio_restart_limit_reached"
        else:
            restart_payload = {"profile": audio_state["profile"]}
            restart_payload.update(audio_state.get("controls") or {})
            if audio_state.get("backend") == "simulated_pcm":
                restart_payload["simulate"] = "true"
            restarted = start_audio(restart_payload)
            fresh.append(now_utc())
            save_audio_state(restart_count=int(audio_state.get("restart_count") or 0) + 1)
            action = "restarted"
            reason = "audio_process_exited"
            status = restarted["audio"]
        save_watchdog_state(
            audio_restart_utc=fresh,
            last_action=action,
            last_reason=reason,
            last_check_utc=now_utc(),
        )
    else:
        save_watchdog_state(last_action=action, last_reason=reason, last_check_utc=now_utc())

    result = watchdog_status()
    result["watchdog"]["action"] = action
    result["watchdog"]["reason"] = reason
    return result


def stream_audio(format_name, params):
    status = audio_status()["audio"]
    if status["state"] != "running":
        raise ApiError("audio_not_running", "audio stream is not running", status=409)
    if dry_run():
        raise ApiError("audio_stream_unavailable", "audio streaming is unavailable in dry-run mode", status=503)
    rate = int(status.get("audio_rate_hz") or 48000)
    seconds = validate_uint(params.get("seconds", 2), "seconds", 1, 10)
    bytes_remaining = rate * 2 * seconds
    if is_cgi():
        print("Content-Type: audio/L16" if format_name == "pcm" else "Content-Type: audio/wav")
        print("Cache-Control: no-store")
        print()
        sys.stdout.flush()
    if format_name == "wav":
        sys.stdout.buffer.write(wav_header(bytes_remaining, rate))
    fd = os.open(str(AUDIO_FIFO), os.O_RDONLY | os.O_NONBLOCK)
    try:
        deadline = time.time() + seconds
        while bytes_remaining > 0 and time.time() < deadline:
            try:
                chunk = os.read(fd, min(4096, bytes_remaining))
            except BlockingIOError:
                time.sleep(0.02)
                continue
            if not chunk:
                time.sleep(0.02)
                continue
            sys.stdout.buffer.write(chunk)
            bytes_remaining -= len(chunk)
    finally:
        os.close(fd)


def capture_base_dir(payload=None):
    payload = payload or {}
    requested = payload.get("directory") or os.environ.get("PLUTO_CAPTURE_DIR")
    base = Path(requested) if requested else DEFAULT_CAPTURE_DIR
    if dry_run():
        return base
    allowed = [Path("/mnt/jffs2"), Path("/media")]
    try:
        resolved = base.resolve()
    except OSError:
        resolved = base
    if not any(str(resolved).startswith(str(root)) for root in allowed):
        raise ApiError("invalid_capture_dir", "capture directory must be under /mnt/jffs2 or /media", details={"directory": str(base)})
    return base


def capture_paths(capture_id, payload=None):
    capture_id = validate_capture_id(capture_id)
    base = capture_base_dir(payload)
    return base / f"{capture_id}.bin", base / f"{capture_id}.json"


def capture_id_for(profile_name, capture_type):
    stamp = time.strftime("%Y%m%d-%H%M%S", time.gmtime())
    return f"{stamp}-{profile_name.lower()}-{capture_type.lower()}"


def capture_metadata_from_file(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def capture_list(params=None):
    base = capture_base_dir(params)
    captures = []
    if base.is_dir():
        for meta_path in sorted(base.glob("*.json")):
            meta = capture_metadata_from_file(meta_path)
            if not meta:
                continue
            data_path = base / f"{meta.get('capture_id', meta_path.stem)}.bin"
            meta["size_bytes"] = data_path.stat().st_size if data_path.is_file() else 0
            captures.append(meta)
    return {"ok": True, "capture_dir": str(base), "captures": captures}


def capture_metadata(params):
    capture_id = validate_capture_id(params.get("capture_id", ""))
    _data_path, meta_path = capture_paths(capture_id, params)
    meta = capture_metadata_from_file(meta_path)
    if not meta:
        raise ApiError("capture_not_found", "capture metadata was not found", status=404, details={"capture_id": capture_id})
    return {"ok": True, "capture": meta}


def start_capture(payload):
    profile = selected_audio_profile(payload) if payload.get("profile") else active_profile_from_state()
    capture_type = payload.get("type", "iq")
    if capture_type not in {"iq", "audio"}:
        raise ApiError("invalid_capture_type", "capture type must be iq or audio", details={"type": capture_type})
    duration = validate_uint(payload.get("duration_seconds", 10), "duration_seconds", 1, CAPTURE_MAX_SECONDS)
    max_bytes = validate_uint(payload.get("max_bytes", CAPTURE_MAX_BYTES), "max_bytes", 1, CAPTURE_MAX_BYTES)
    capture_id = validate_capture_id(payload.get("capture_id") or capture_id_for(profile["name"], capture_type))
    data_path, meta_path = capture_paths(capture_id, payload)

    metadata = {
        "capture_id": capture_id,
        "type": capture_type,
        "profile": profile["name"],
        "frequency_hz": load_state().get("requested_frequency_hz") or profile.get("default_frequency_hz"),
        "sample_rate_hz": profile.get("sample_rate_hz"),
        "rf_bandwidth_hz": profile.get("rf_bandwidth_hz"),
        "gain_db": load_state().get("gain_db") or profile.get("gain_db"),
        "duration_seconds": duration,
        "max_bytes": max_bytes,
        "created_utc": now_utc(),
        "data_path": str(data_path),
        "metadata_path": str(meta_path),
        "backend": "simulated" if str(payload.get("simulate", "")).lower() in {"1", "true", "yes"} else "external",
        "state": "complete",
    }

    if dry_run():
        return {"ok": True, "capture": metadata}

    data_path.parent.mkdir(parents=True, exist_ok=True)
    simulate = str(payload.get("simulate", "")).lower() in {"1", "true", "yes"}
    if simulate:
        sample_size = min(max_bytes, 4096)
        with data_path.open("wb") as handle:
            handle.write(bytes((idx % 256 for idx in range(sample_size))))
        metadata["size_bytes"] = sample_size
    else:
        if not CAPTURE_BACKEND.is_file() or not os.access(str(CAPTURE_BACKEND), os.X_OK):
            raise ApiError("capture_backend_missing", f"capture backend is not installed: {CAPTURE_BACKEND}", status=503)
        env = os.environ.copy()
        env.update(
            {
                "PLUTO_CAPTURE_PATH": str(data_path),
                "PLUTO_CAPTURE_TYPE": capture_type,
                "PLUTO_CAPTURE_PROFILE": profile["name"],
                "PLUTO_CAPTURE_DURATION_SECONDS": str(duration),
                "PLUTO_CAPTURE_MAX_BYTES": str(max_bytes),
            }
        )
        proc = subprocess.run([str(CAPTURE_BACKEND)], check=False, env=env, timeout=duration + 5)
        if proc.returncode != 0:
            raise ApiError("capture_failed", "capture backend failed", status=503, details={"returncode": proc.returncode})
        metadata["size_bytes"] = data_path.stat().st_size if data_path.is_file() else 0

    meta_path.write_text(json.dumps(metadata, sort_keys=True) + "\n", encoding="utf-8")
    return {"ok": True, "capture": metadata}


def delete_capture(payload):
    capture_id = validate_capture_id(payload.get("capture_id", ""))
    data_path, meta_path = capture_paths(capture_id, payload)
    removed = []
    for path in (data_path, meta_path):
        try:
            path.unlink()
            removed.append(str(path))
        except FileNotFoundError:
            pass
        except OSError as exc:
            raise ApiError("capture_delete_failed", str(exc), status=500)
    return {"ok": True, "capture_id": capture_id, "removed": removed}


def download_capture(params):
    capture_id = validate_capture_id(params.get("capture_id", ""))
    data_path, _meta_path = capture_paths(capture_id, params)
    if not data_path.is_file():
        raise ApiError("capture_not_found", "capture data was not found", status=404, details={"capture_id": capture_id})
    if is_cgi():
        print("Content-Type: application/octet-stream")
        print("Cache-Control: no-store")
        print(f"Content-Disposition: attachment; filename=\"{capture_id}.bin\"")
        print()
    with data_path.open("rb") as handle:
        shutil.copyfileobj(handle, sys.stdout.buffer)


def spectrum_profile(payload):
    if payload.get("profile"):
        profile = get_profile(payload["profile"])
        if "frequency_hz" in payload or "gain_db" in payload:
            apply_profile(payload)
        return profile
    return active_profile_from_state()


def simulated_spectrum(center_hz, span_hz, bins, top_n, sequence=0):
    start_hz = center_hz - span_hz // 2
    step_hz = span_hz / max(1, bins - 1)
    drift = (sequence % 24) - 12
    carriers = (
        (center_hz - span_hz * 0.18 + drift * step_hz * 0.20, -49.0),
        (center_hz + span_hz * 0.07 - drift * step_hz * 0.15, -42.0),
        (center_hz + span_hz * 0.31 + drift * step_hz * 0.10, -56.0),
    )
    points = []
    for idx in range(bins):
        freq = int(start_hz + idx * step_hz)
        baseline = -92.0 + ((idx * 17) % 11) * 0.45
        power = baseline
        for carrier_freq, carrier_power in carriers:
            distance_bins = abs(freq - carrier_freq) / max(1.0, step_hz)
            if distance_bins < 3:
                power = max(power, carrier_power - distance_bins * 5.5)
        points.append({"frequency_hz": freq, "power_dbfs": round(power, 2)})
    noise_floor = round(sum(point["power_dbfs"] for point in points) / len(points), 2)
    peaks = sorted(points, key=lambda point: point["power_dbfs"], reverse=True)[:top_n]
    for peak in peaks:
        peak["snr_db"] = round(peak["power_dbfs"] - noise_floor, 2)
    return points, peaks, noise_floor


def doppler_center_from_plan(plan, now_ms):
    if not plan:
        return None
    table = plan.get("doppler_table", [])
    if not table:
        return None
    start_ms = int(plan.get("start_epoch_ms") or 0)
    elapsed_ms = int(now_ms) - start_ms
    before = None
    after = None
    for point in table:
        offset_ms = int(point.get("offset_ms") or 0)
        frequency_hz = int(point.get("frequency_hz") or 0)
        if frequency_hz <= 0:
            continue
        if offset_ms <= elapsed_ms:
            before = (offset_ms, frequency_hz)
        if offset_ms >= elapsed_ms:
            after = (offset_ms, frequency_hz)
            break
    if before and after:
        if after[0] == before[0]:
            return before[1]
        ratio = (elapsed_ms - before[0]) / max(1, after[0] - before[0])
        return int(round(before[1] + ((after[1] - before[1]) * ratio)))
    if before:
        return before[1]
    if after:
        return after[1]
    return None


def write_spectrum_doppler_file(plan):
    table = plan.get("doppler_table", []) if plan else []
    if not table:
        return None
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=str(STATE_DIR), prefix="spectrum-doppler-", suffix=".csv", delete=False)
    try:
        for point in table:
            handle.write(f"{int(point.get('offset_ms') or 0)} {int(point.get('frequency_hz') or 0)}\n")
        return Path(handle.name)
    finally:
        handle.close()


